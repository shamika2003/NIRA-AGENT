<Window x:Class="NIRAAgent.UI.PermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:NIRAAgent.UI"
        Title="NIRA Permissions"
        Width="1180"
        Height="780"
        MinWidth="760"
        MinHeight="455"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource NIRABackgroundBrush}"
        Foreground="{DynamicResource NIRATextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PermissionGlassCard" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <ui:NIRAUtilityBackdropBorder Margin="-18" BlurRadius="14" BackdropOpacity="0.72"/>
                            <Border Background="{DynamicResource NIRAGlassTintBrush}"
                                    BorderBrush="{DynamicResource NIRAGlassBorderStrongBrush}"
                                    BorderThickness="1.4"
                                    CornerRadius="18">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionGlassCardStrong" TargetType="ContentControl" BasedOn="{StaticResource PermissionGlassCard}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <ui:NIRAUtilityBackdropBorder Margin="-20" BlurRadius="16" BackdropOpacity="0.78"/>
                            <Border Background="{DynamicResource NIRAGlassStrongTintBrush}"
                                    BorderBrush="{DynamicResource NIRAFocusBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="19">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionWindowButton" TargetType="Button" BasedOn="{StaticResource NIRAButtonBaseStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="PermissionWindowControl" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRASecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.26">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.022"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.022"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard></BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionTabsStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,5"
                                      KeyboardNavigation.TabIndex="1" Background="Transparent"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"
                                              Margin="0" KeyboardNavigation.TabIndex="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource NIRASecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="0,0,8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="{DynamicResource NIRAChipBrush}"
                                BorderBrush="{DynamicResource NIRAGlassBorderBrush}"
                                BorderThickness="1" CornerRadius="11">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionRequestItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="13,12"/>
            <Setter Property="Background" Value="#0BFFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PermissionAuditRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="{DynamicResource NIRAChipBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PermissionAuditCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PermissionAuditHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{DynamicResource NIRAChipBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="PermissionAuditText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootShell">
        <Image x:Name="UtilityBackgroundEclipse" Source="Assets/nira-utility-eclipse.png" Stretch="UniformToFill" Opacity="1" IsHitTestVisible="False"/>
        <Image x:Name="UtilityBackgroundHalo" Source="Assets/nira-utility-halo.png" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/>
        <Rectangle Fill="{DynamicResource NIRABackdropVeilBrush}" Opacity="0.58" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0" MouseLeftButtonDown="PermissionsTitleBar_MouseLeftButtonDown">
                <ui:NIRAUtilityBackdropBorder Margin="0,-10,0,-6" BlurRadius="12" BackdropOpacity="0.60"/>
                <Border Background="{DynamicResource NIRATopBarTintBrush}" BorderBrush="{DynamicResource NIRAGlassBorderBrush}" BorderThickness="0,0,0,1"/>
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="40" Height="40" Margin="0,0,13,0"
                               Source="Assets/Nira-Icon.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NIRA" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text=" / PERMISSIONS" Margin="7,7,0,0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="ACCESS CONTROL · APPROVALS · AUDIT" Margin="1,0,0,0" FontSize="7.5" Foreground="{DynamicResource NIRAMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PermissionWindowControl}" Click="PermissionsMinimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="12" Height="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Data="M0,0 L12,0"/>
                        </Button>
                        <Button Style="{StaticResource PermissionWindowControl}" Click="PermissionsMaximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M1,1 L10,1 L10,10 L1,10 Z"/>
                        </Button>
                        <Button Style="{StaticResource PermissionWindowControl}" Click="PermissionsClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Data="M1,1 L10,10 M10,1 L1,10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- BODY -->
            <Grid Grid.Row="1" Margin="20,18,20,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Permissions" FontSize="30" FontWeight="Light"/>
                        <TextBlock Text="Review what NIRA wants to do, keep trusted scopes, and inspect the authorization trail."
                                   Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="13,8" CornerRadius="12" Background="{DynamicResource NIRAChipBrush}" BorderBrush="{DynamicResource NIRAGlassBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource NIRAGreenBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SECURE SESSION" FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TabControl x:Name="Tabs" Grid.Row="2" Style="{StaticResource PermissionTabsStyle}" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource PermissionTabItemStyle}"/>
                    </TabControl.Resources>

                    <!-- REQUESTS -->
                    <TabItem Header="Requests">
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                            <ContentControl Grid.Column="0" Style="{StaticResource PermissionGlassCardStrong}">
                                <Grid Margin="15">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Pending requests" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Select a request to review its exact scope." Margin="0,4,0,12" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                    </StackPanel>
                                    <ListBox x:Name="RequestsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PermissionRequestItem}" SelectionChanged="Request_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Operation.Request.CapabilityId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Operation.Target}" Margin="0,3,0,0" FontSize="9.5" Foreground="{DynamicResource NIRASecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Operation.Risk}" Margin="0,4,0,0" FontSize="8.5" Foreground="{DynamicResource NIRACyanBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </ContentControl>

                            <ContentControl Grid.Column="2" Style="{StaticResource PermissionGlassCard}">
                                <Grid Margin="18,16">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="REQUEST REVIEW" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource NIRACyanBrush}"/>
                                            <TextBlock x:Name="RequestTitle" Text="No pending request" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="RequestTarget" Margin="0,7,0,10" TextWrapping="Wrap" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                            <TextBlock x:Name="RequestNotice" TextWrapping="Wrap" Foreground="{DynamicResource NIRASecondaryBrush}" Margin="0,0,0,14"/>

                                            <TextBlock Text="Why NIRA is asking" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource NIRAMutedBrush}"/>
                                            <TextBlock x:Name="RequestReason" TextWrapping="Wrap" Margin="0,5,0,14"/>

                                            <TextBlock Text="Exact operation" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource NIRAMutedBrush}"/>
                                            <TextBox x:Name="RequestPreview" Margin="0,5,0,14" MinHeight="90" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                                            <TextBlock Text="Delegated access" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource NIRAMutedBrush}"/>
                                            <TextBlock x:Name="RememberDescription" Margin="0,5,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                            <TextBox x:Name="RememberRoot" Visibility="Collapsed"/>

                                            <StackPanel x:Name="ExecutionProfilesPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                <TextBlock Text="PROJECT EXECUTION PREFLIGHT" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource NIRACyanBrush}"/>
                                                <TextBlock Text="Approve bounded command families now so NIRA can build/test or inspect the repository later in this task without interrupting you again."
                                                           Margin="0,5,0,8" TextWrapping="Wrap" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                                <CheckBox x:Name="DotNetBuildTestCheck" Content=".NET build/test — dotnet clean, restore, build, test" Margin="0,3,0,3"/>
                                                <CheckBox x:Name="GitInspectCheck" Content="Git inspection — status, diff, log, show, rev-parse, remote -v, branch listing" Margin="0,3,0,3"/>
                                                <TextBlock Text="These are bounded profiles, not unrestricted shell access. Commands outside the selected families still require a new decision."
                                                           Margin="0,6,0,0" FontSize="9.5" TextWrapping="Wrap" Foreground="{DynamicResource NIRAMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Grid Grid.Row="1" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button x:Name="OnceButton" Content="Allow once" Style="{StaticResource NIRAPrimaryButtonStyle}" Margin="0,0,8,0" Click="AllowOnce_Click" IsEnabled="False"/>
                                        <Button x:Name="TaskButton" Grid.Column="1" Content="Allow for this task" Style="{StaticResource PermissionWindowButton}" Margin="0,0,8,0" Click="AllowTask_Click" IsEnabled="False"/>
                                        <Button x:Name="RememberButton" Grid.Column="2" Content="Remember" Style="{StaticResource PermissionWindowButton}" Margin="0,0,8,0" Click="Remember_Click" IsEnabled="False"/>
                                        <Button x:Name="DenyButton" Grid.Column="3" Content="Deny" Style="{StaticResource NIRADangerButtonStyle}" Click="Deny_Click" IsEnabled="False"/>
                                        <TextBlock Grid.Column="4" Text="Approve the boundary, not every step." HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9.5" Foreground="{DynamicResource NIRAMutedBrush}"/>
                                    </Grid>
                                </Grid>
                            </ContentControl>
                        </Grid>
                    </TabItem>

                    <!-- SAVED GRANTS -->
                    <TabItem Header="Saved grants">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <!-- Show actual saved grants immediately. Expand only when a new folder grant is needed. -->
                            <Expander x:Name="GrantAccessExpander" IsExpanded="False"
                                      Foreground="{DynamicResource NIRATextBrush}">
                                <Expander.Header>
                                    <Border Background="{DynamicResource NIRAChipBrush}"
                                            BorderBrush="{DynamicResource NIRAGlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="11" Padding="12,9">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Grant project-folder access" FontWeight="SemiBold"/>
                                            <TextBlock Text="  ·  Expand to add a grant" FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Expander.Header>
                                <ContentControl Style="{StaticResource PermissionGlassCard}" Margin="0,8,0,0">
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Grant project-folder access" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Saved grants authorize actions. They are NOT website passwords or proof of a signed-in account. Website logins are selected in the separate secure credential window."
                                                   TextWrapping="Wrap" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                        <TextBlock Text="Folder path" Margin="0,10,0,4" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource NIRAMutedBrush}"/>
                                        <TextBox x:Name="ProjectRoot" Margin="0,0,16,8"/>
                                        <WrapPanel>
                                            <CheckBox x:Name="DownloadsCheck" Content="Allow downloads into this folder" Margin="0,3,20,3"/>
                                            <CheckBox x:Name="DestructiveCheck" Content="Allow destructive operations" Margin="0,3,20,3"/>
                                        </WrapPanel>
                                        <TextBlock Text="Optional bounded project execution" Margin="0,9,0,4" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource NIRAMutedBrush}"/>
                                        <WrapPanel>
                                            <CheckBox x:Name="SavedDotNetBuildTestCheck" Content=".NET build/test" Margin="0,3,20,3"/>
                                            <CheckBox x:Name="SavedGitInspectCheck" Content="Git inspection" Margin="0,3,20,3"/>
                                        </WrapPanel>
                                        <TextBlock Text="Selected profiles work only inside this folder and never become unrestricted shell authority." Margin="0,6,0,0" FontSize="9.5" TextWrapping="Wrap" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Grant access" Width="124" Style="{StaticResource NIRAPrimaryButtonStyle}" VerticalAlignment="Bottom" Click="GrantFolder_Click"/>
                                </Grid>
                                </ContentControl>
                            </Expander>

                            <ContentControl Grid.Row="2" Style="{StaticResource PermissionGlassCardStrong}">
                                <Grid Margin="14,12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="9"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <TextBlock Text="Active saved grants" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="GrantListCount" Text="0 active" Margin="12,3,0,0"
                                                   FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                    </DockPanel>
                                    <ListBox x:Name="ScopesList" Grid.Row="2" Background="Transparent"
                                             BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource PermissionRequestItem}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,1">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </ContentControl>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Revoke selected" Style="{StaticResource NIRADangerButtonStyle}" Margin="0,0,8,0" Click="Revoke_Click"/>
                                <Button Content="Refresh" Style="{StaticResource PermissionWindowButton}" Click="Refresh_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- AUDIT -->
                    <TabItem Header="Action audit">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ContentControl Style="{StaticResource PermissionGlassCardStrong}">
                                <Grid Margin="14">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="Latest authorization and execution records" FontSize="15" FontWeight="SemiBold"/>
                                    <DataGrid Grid.Row="2" x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                              HeadersVisibility="Column" RowHeight="44" ColumnHeaderHeight="38"
                                              GridLinesVisibility="None" SelectionUnit="FullRow" SelectionMode="Single"
                                              RowStyle="{StaticResource PermissionAuditRow}"
                                              CellStyle="{StaticResource PermissionAuditCell}"
                                              ColumnHeaderStyle="{StaticResource PermissionAuditHeader}"
                                              AlternationCount="2" Background="Transparent" BorderThickness="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="UTC time" ElementStyle="{StaticResource PermissionAuditText}" Binding="{Binding TimeUtc}" Width="156"/>
                                            <DataGridTextColumn Header="Capability" ElementStyle="{StaticResource PermissionAuditText}" Binding="{Binding Capability}" Width="1.05*" MinWidth="115"/>
                                            <DataGridTextColumn Header="Result" ElementStyle="{StaticResource PermissionAuditText}" Binding="{Binding Status}" Width="100"/>
                                            <DataGridTextColumn Header="Target" ElementStyle="{StaticResource PermissionAuditText}" Binding="{Binding Target}" Width="1.4*" MinWidth="145"/>
                                            <DataGridTextColumn Header="Evidence" ElementStyle="{StaticResource PermissionAuditText}" Binding="{Binding Detail}" Width="1.7*" MinWidth="180"/>
                                            <DataGridTextColumn Header="Scope" ElementStyle="{StaticResource PermissionAuditText}" Binding="{Binding ScopeId}" Width="1.05*" MinWidth="130"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </ContentControl>
                            <Button Grid.Row="1" Content="Refresh audit" Width="120" Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource PermissionWindowButton}" Click="Refresh_Click"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- STATUS -->
            <Grid Grid.Row="2">
                <ui:NIRAUtilityBackdropBorder Margin="0,-5,0,0" BlurRadius="10" BackdropOpacity="0.56"/>
                <Border Background="{DynamicResource NIRATopBarTintBrush}" BorderBrush="{DynamicResource NIRAGlassBorderBrush}" BorderThickness="0,1,0,0"/>
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource NIRACyanBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="0 pending request(s) / 0 active saved grant(s)" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>
