<Window x:Class="NIRAAgent.UI.Companion.NIRABlobStyleShowcaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NIRA Blob Style Picker"
        Width="1620"
        Height="980"
        Background="#030919"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="NIRA  |  BLOB STYLE PICKER"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="#F0F6FF"/>
                <TextBlock Text="Pick the vibe first. Then we wire the selected one into the main NIRA presence."
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="#92A9CA"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Button x:Name="AnimateButton"
                        Width="136"
                        Height="38"
                        Margin="0,0,8,0"
                        Content="Pause Demo"
                        Click="AnimateButton_Click"/>
                <Button Width="100"
                        Height="38"
                        Content="Close"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2"
                     Rows="2"
                     Columns="3">
            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180A1328">
                <StackPanel>
                    <ContentControl x:Name="EclipseHost" Width="250" Height="250" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,10,0,0" Text="ECLIPSE GLASS" HorizontalAlignment="Center" Foreground="#F4F8FF" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Premium / Main UI" HorizontalAlignment="Center" Foreground="#94B0D6" FontSize="13"/>
                    <TextBlock Margin="0,10,0,0" Text="Strong default candidate for NIRA." TextWrapping="Wrap" Foreground="#AFC3E4" FontSize="12" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180A1328">
                <StackPanel>
                    <ContentControl x:Name="HaloHost" Width="250" Height="250" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,10,0,0" Text="HALO BLOOM" HorizontalAlignment="Center" Foreground="#F4F8FF" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Soft / Light Theme" HorizontalAlignment="Center" Foreground="#94B0D6" FontSize="13"/>
                    <TextBlock Margin="0,10,0,0" Text="Best if you want a brighter cleaner feel." TextWrapping="Wrap" Foreground="#AFC3E4" FontSize="12" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180A1328">
                <StackPanel>
                    <ContentControl x:Name="OrbitHost" Width="250" Height="250" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,10,0,0" Text="ORBIT FLOW" HorizontalAlignment="Center" Foreground="#F4F8FF" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Listening / Motion" HorizontalAlignment="Center" Foreground="#94B0D6" FontSize="13"/>
                    <TextBlock Margin="0,10,0,0" Text="Feels lively and moving without being noisy." TextWrapping="Wrap" Foreground="#AFC3E4" FontSize="12" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180A1328">
                <StackPanel>
                    <ContentControl x:Name="LatticeHost" Width="250" Height="250" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,10,0,0" Text="LATTICE CORE" HorizontalAlignment="Center" Foreground="#F4F8FF" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Thinking / Precision" HorizontalAlignment="Center" Foreground="#94B0D6" FontSize="13"/>
                    <TextBlock Margin="0,10,0,0" Text="Technical intelligence look. Great for focus mode." TextWrapping="Wrap" Foreground="#AFC3E4" FontSize="12" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180A1328">
                <StackPanel>
                    <ContentControl x:Name="NebulaHost" Width="250" Height="250" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,10,0,0" Text="NEBULA PULSE" HorizontalAlignment="Center" Foreground="#F4F8FF" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Expressive / Speaking" HorizontalAlignment="Center" Foreground="#94B0D6" FontSize="13"/>
                    <TextBlock Margin="0,10,0,0" Text="Richer inner movement for a stronger character presence." TextWrapping="Wrap" Foreground="#AFC3E4" FontSize="12" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180A1328">
                <StackPanel>
                    <ContentControl x:Name="MinimalHost" Width="250" Height="250" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,10,0,0" Text="QUIET MINIMAL" HorizontalAlignment="Center" Foreground="#F4F8FF" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Calm / Resting" HorizontalAlignment="Center" Foreground="#94B0D6" FontSize="13"/>
                    <TextBlock Margin="0,10,0,0" Text="Luxury minimalist. Good if you want less visual noise." TextWrapping="Wrap" Foreground="#AFC3E4" FontSize="12" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4"
                Padding="16"
                CornerRadius="18"
                BorderThickness="1"
                BorderBrush="#28486FBD"
                Background="#140F1730">
            <TextBlock Foreground="#95AECE"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Text="How to use: run the app with --blob-style-showcase. Pick one style you like. After that, I can wire only that selected style into the main left presence orb and companion panel."/>
        </Border>
    </Grid>
</Window>

