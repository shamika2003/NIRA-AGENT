<Window x:Class="NIRAAgent.UI.Companion.NIRABlobShowcaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NIRA Blob Showcase"
        Width="1500"
        Height="980"
        Background="#030818"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="NIRA  |  BLOB VISUAL SYSTEM"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="#F0F6FF"/>
                <TextBlock Text="Living presence  •  calm intelligence  •  always onward"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="#87A1C4"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Button x:Name="CycleSpeakingButton"
                        Width="144"
                        Height="38"
                        Margin="0,0,8,0"
                        Content="Pause Speaking"
                        Click="CycleSpeakingButton_Click"/>
                <Button Width="100"
                        Height="38"
                        Content="Close"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2"
                     Rows="2"
                     Columns="4">
            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180B1328">
                <StackPanel>
                    <ContentControl x:Name="CoreHost" Width="220" Height="220" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,12,0,0" Text="01  CORE" HorizontalAlignment="Center" Foreground="#F3F8FF" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Default / Idle" HorizontalAlignment="Center" Foreground="#98B0D3" FontSize="13"/>
                </StackPanel>
            </Border>
            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180B1328">
                <StackPanel>
                    <ContentControl x:Name="FlowHost" Width="220" Height="220" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,12,0,0" Text="02  FLOW" HorizontalAlignment="Center" Foreground="#F3F8FF" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Listening" HorizontalAlignment="Center" Foreground="#98B0D3" FontSize="13"/>
                </StackPanel>
            </Border>
            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180B1328">
                <StackPanel>
                    <ContentControl x:Name="FocusHost" Width="220" Height="220" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,12,0,0" Text="03  FOCUS" HorizontalAlignment="Center" Foreground="#F3F8FF" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Thinking" HorizontalAlignment="Center" Foreground="#98B0D3" FontSize="13"/>
                </StackPanel>
            </Border>
            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180B1328">
                <StackPanel>
                    <ContentControl x:Name="SpeakHost" Width="220" Height="220" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,12,0,0" Text="04  SPEAK" HorizontalAlignment="Center" Foreground="#F3F8FF" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Speaking" HorizontalAlignment="Center" Foreground="#98B0D3" FontSize="13"/>
                </StackPanel>
            </Border>
            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180B1328">
                <StackPanel>
                    <ContentControl x:Name="WarmHost" Width="220" Height="220" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,12,0,0" Text="05  WARM" HorizontalAlignment="Center" Foreground="#F3F8FF" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Positive / Happy" HorizontalAlignment="Center" Foreground="#98B0D3" FontSize="13"/>
                </StackPanel>
            </Border>
            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180B1328">
                <StackPanel>
                    <ContentControl x:Name="AlertHost" Width="220" Height="220" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,12,0,0" Text="06  ALERT" HorizontalAlignment="Center" Foreground="#F3F8FF" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Important / Attention" HorizontalAlignment="Center" Foreground="#98B0D3" FontSize="13"/>
                </StackPanel>
            </Border>
            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180B1328">
                <StackPanel>
                    <ContentControl x:Name="CalmHost" Width="220" Height="220" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,12,0,0" Text="07  CALM" HorizontalAlignment="Center" Foreground="#F3F8FF" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Resting / Low Activity" HorizontalAlignment="Center" Foreground="#98B0D3" FontSize="13"/>
                </StackPanel>
            </Border>
            <Border Margin="10" Padding="18" CornerRadius="24"
                    BorderBrush="#305B84D8" BorderThickness="1" Background="#180B1328">
                <StackPanel>
                    <ContentControl x:Name="CustomHost" Width="220" Height="220" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,12,0,0" Text="08  CUSTOM" HorizontalAlignment="Center" Foreground="#F3F8FF" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Mood / Special" HorizontalAlignment="Center" Foreground="#98B0D3" FontSize="13"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" CornerRadius="18" Padding="16"
                Background="#140F1730" BorderBrush="#28486FBD" BorderThickness="1">
            <TextBlock TextWrapping="Wrap"
                       Foreground="#94AACE"
                       FontSize="13"
                       Text="This renderer pack changes the actual orb drawing, not just the intent values. Use it to preview the more visible shell, rim, aura, orbit, focus-network, alert-spike, and calm-minimal variations."/>
        </Border>
    </Grid>
</Window>

