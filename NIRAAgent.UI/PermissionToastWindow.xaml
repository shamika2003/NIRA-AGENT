<Window x:Class="NIRAAgent.UI.PermissionToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NIRA Access Request"
        Width="430"
        MinHeight="196"
        MaxHeight="540"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource NIRATextBrush}"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ToastSmallButton"
               TargetType="Button"
               BasedOn="{StaticResource NIRAButtonBaseStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#DA0A1428"/>
            <Setter Property="BorderBrush" Value="#4C4777AA"/>
            <Setter Property="Foreground" Value="#CEE8FA"/>
        </Style>

        <Style x:Key="ToastLinkButton"
               TargetType="Button"
               BasedOn="{StaticResource NIRAButtonBaseStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Background" Value="#120D1A2E"/>
            <Setter Property="BorderBrush" Value="#304D6B91"/>
            <Setter Property="Foreground" Value="#88B6D2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border x:Name="ToastRoot"
                Padding="16,14"
                CornerRadius="16"
                Background="#F2071020"
                BorderBrush="#6E78DBFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#4D8FFF"
                                  BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.34"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" X="6"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse Width="32" Height="32" Fill="#17235DB3"/>
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource NIRACyanBrush}"/>
                        <Ellipse Width="3" Height="3" Fill="White"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NIRA NEEDS PERMISSION"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#DDF6FF"/>
                        <TextBlock x:Name="PendingCountText"
                                   Margin="0,2,0,0"
                                   FontSize="9"
                                   Foreground="#6989A8"/>
                    </StackPanel>

                    <Border x:Name="RiskBadgeBorder"
                            Grid.Column="2"
                            Padding="8,3"
                            CornerRadius="8"
                            Background="#1D78DBFF"
                            BorderBrush="#5D78DBFF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="RiskText"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource NIRACyanBrush}"/>
                    </Border>
                </Grid>

                <!-- REQUEST -->
                <StackPanel Grid.Row="1" Margin="0,13,0,0">
                    <TextBlock x:Name="CapabilityText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#E6F3FF"/>
                    <TextBlock x:Name="TargetText"
                               Margin="0,5,0,0"
                               MaxHeight="38"
                               FontSize="10"
                               LineHeight="15"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#82D7FF"/>
                    <TextBlock x:Name="ReasonText"
                               Margin="0,8,0,0"
                               MaxHeight="48"
                               FontSize="10.5"
                               LineHeight="16"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#B8CADB"/>
                </StackPanel>

                <!-- QUICK ACTIONS -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="AllowOnceButton"
                            Grid.Column="0"
                            Content="Allow once"
                            Style="{StaticResource NIRAPrimaryButtonStyle}"
                            Height="32"
                            Padding="12,5"
                            Margin="0,0,7,0"
                            Click="AllowOnce_Click"/>

                    <Button x:Name="RememberButton"
                            Grid.Column="1"
                            Content="Remember"
                            Style="{StaticResource ToastSmallButton}"
                            Click="Remember_Click"/>

                    <Button x:Name="DenyButton"
                            Grid.Column="2"
                            Content="Deny"
                            Style="{StaticResource NIRADangerButtonStyle}"
                            Height="32"
                            Padding="12,5"
                            Margin="0,0,7,0"
                            Click="Deny_Click"/>

                    <Button x:Name="DetailsButton"
                            Grid.Column="4"
                            Content="Details"
                            Style="{StaticResource ToastLinkButton}"
                            Margin="0"
                            Click="DetailsButton_Click"/>
                </Grid>

                <TextBlock x:Name="RememberHintText"
                           Grid.Row="3"
                           Margin="0,8,0,0"
                           MaxHeight="30"
                           FontSize="8.5"
                           LineHeight="13"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#617F9C"/>

                <!-- EXPANDED DETAILS -->
                <Border x:Name="DetailsPanel"
                        Grid.Row="4"
                        Margin="0,11,0,0"
                        Padding="11,10"
                        Visibility="Collapsed"
                        CornerRadius="11"
                        Background="#97060D19"
                        BorderBrush="#33496C95"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="WHY THIS NEEDS REVIEW"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Foreground="#617E9B"/>
                        <TextBlock x:Name="NoticeText"
                                   Margin="0,4,0,9"
                                   FontSize="9.5"
                                   LineHeight="14"
                                   TextWrapping="Wrap"
                                   Foreground="#AFC3D6"/>

                        <TextBlock Text="EXACT REQUEST"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Foreground="#617E9B"/>
                        <Border Margin="0,5,0,9"
                                Padding="8,7"
                                CornerRadius="8"
                                Background="#D3040912"
                                BorderBrush="#283A5673"
                                BorderThickness="1">
                            <ScrollViewer MaxHeight="132"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ExactPreviewText"
                                           FontFamily="Consolas"
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Foreground="#A9C6DB"/>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="REMEMBER SCOPE"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Foreground="#617E9B"/>
                        <TextBlock x:Name="RememberScopeText"
                                   Margin="0,4,0,9"
                                   FontSize="9.5"
                                   TextWrapping="Wrap"
                                   Foreground="#9AB7D0"/>

                        <Button Content="Open full Permissions"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ToastLinkButton}"
                                Click="OpenFullPermissions_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           Grid.Row="5"
                           Margin="0,10,0,0"
                           FontSize="8.5"
                           Foreground="#5B7690"/>
            </Grid>
        </Border>
    </Grid>
</Window>
