<Window x:Class="NIRAAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:NIRAAgent.UI.ViewModels"
        xmlns:ui="clr-namespace:NIRAAgent.UI"
        xmlns:typing="clr-namespace:NIRAAgent.UI.Typing"
        Title="NIRA by ELVARA"
        Icon="Assets/Nira-Icon.ico"
        Width="1440"
        Height="900"
        MinWidth="1160"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource NIRABackgroundBrush}"
        Foreground="{DynamicResource NIRATextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#08060915" Offset="0"/>
            <GradientStop Color="#12091230" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="UserBubble" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#40223D84" Offset="0"/>
            <GradientStop Color="#40205CB2" Offset="1"/>
        </LinearGradientBrush>


        <!-- Thin, low-distraction scrollbars for chat, activity lists and inputs. -->
        <Style x:Key="ThinScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#7B5A8AC6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                Margin="0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Opacity="0.52"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="ThumbRoot" Property="Background" Value="#A070A9E6"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Opacity" Value="1"/>
                                <Setter TargetName="ThumbRoot" Property="Background" Value="#C178DBFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.76"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollRoot"
                              Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="5"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="5"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Native-inspired window controls: flat, quiet, and familiar,
             while keeping NIRA's dark blue interface language. -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#91A8BE"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#25213144"/>
                                <Setter Property="Foreground" Value="#E8F5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#34314A63"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8C3B3045"/>
                    <Setter Property="Foreground" Value="#FFF3F6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B64A3148"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="124"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#15111F3E"/>
            <Setter Property="Foreground" Value="#D9F5FF"/>
            <Setter Property="BorderBrush" Value="#4C5E7CFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Glow"
                                    CornerRadius="9"
                                    Background="#1A558CFF"
                                    Opacity="0.24"/>
                            <Border x:Name="Core"
                                    Margin="1"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.82"/>
                                <Setter TargetName="Core" Property="Background" Value="#2920496A"/>
                                <Setter TargetName="Core" Property="BorderBrush" Value="#AA82FFFF"/>
                                <Setter Property="Foreground" Value="#F6FDFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Core" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button" BasedOn="{StaticResource NIRAPrimaryButtonStyle}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Glow"
                                     Width="46"
                                     Height="46"
                                     Fill="#1E4578FF"
                                     Opacity="0.46"/>
                            <Border x:Name="Core"
                                    Margin="3"
                                    CornerRadius="14"
                                    Background="{DynamicResource NIRAPrimaryButtonFill}"
                                    BorderBrush="#B6C8FAFF"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                <Setter TargetName="Core" Property="BorderBrush" Value="#F0E8FFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Core" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="UserMessageTemplate">
            <StackPanel x:Name="UserMessageRoot"
                        HorizontalAlignment="Right"
                        Margin="96,0,0,20"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="UserMessageTranslate" X="4"/>
                </StackPanel.RenderTransform>
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="UserMessageRoot"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="UserMessageTranslate"
                                                 Storyboard.TargetProperty="X"
                                                 From="4" To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
                <TextBlock Text="YOU"
                           HorizontalAlignment="Right"
                           Margin="0,0,8,6"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#6686A6"/>
                <Grid MaxWidth="720">
                    <Border Margin="-2"
                            CornerRadius="18,18,5,18"
                            Background="#12396CFF"
                            Opacity="0.48"/>
                    <Border Margin="1"
                            Padding="17,12"
                            Background="{StaticResource UserBubble}"
                            BorderBrush="#7570F4FF"
                            BorderThickness="1"
                            CornerRadius="17,17,5,17">
                        <TextBlock Text="{Binding Content}"
                                   Foreground="{DynamicResource NIRATextBrush}"
                                   FontSize="14"
                                   LineHeight="21"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate">
            <StackPanel x:Name="AssistantMessageRoot"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,25"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="AssistantMessageTranslate" X="-4"/>
                </StackPanel.RenderTransform>
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="AssistantMessageRoot"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="AssistantMessageTranslate"
                                                 Storyboard.TargetProperty="X"
                                                 From="-4" To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,6">
                    <Ellipse Width="6" Height="6"
                             Fill="{DynamicResource NIRACyanBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"/>
                    <TextBlock Text="NIRA"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource NIRACyanBrush}"/>
                </StackPanel>

                <!-- Assistant prose is full-width and borderless. Actual rich
                     visuals retain their own themed surfaces where helpful. -->
                <Grid HorizontalAlignment="Stretch">
                    <Border x:Name="AssistantBubble"
                            Padding="6,1,8,0"
                            MinWidth="0"
                            Background="Transparent"
                            BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="AssistantContentText"
                                       Grid.Row="0"
                                       Text="{Binding Content}"
                                       Foreground="{DynamicResource NIRATextBrush}"
                                       FontSize="14"
                                       LineHeight="21"
                                       TextWrapping="Wrap"/>

                            <ItemsControl x:Name="AssistantRichBlocks" Grid.Row="1"
                                          ItemsSource="{Binding RichElements}" Visibility="Collapsed"/>

                            <ItemsControl x:Name="AssistantVisualArtifacts"
                                          Grid.Row="2"
                                          ItemsSource="{Binding VisualArtifacts}"
                                          Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,11,0,0"
                                                MaxWidth="680"
                                                Background="{DynamicResource NIRAGlassStrongTintBrush}"
                                                BorderBrush="#584C91C9"
                                                BorderThickness="1"
                                                CornerRadius="13"
                                                ClipToBounds="True">
                                            <StackPanel>
                                                <Grid Background="#FF020711"
                                                      MinHeight="120"
                                                      MaxHeight="390">
                                                    <Image Source="{Binding PreviewImage}"
                                                           Stretch="Uniform"
                                                           MaxHeight="390"
                                                           SnapsToDevicePixels="True"
                                                           Cursor="Hand"
                                                           MouseLeftButtonUp="VisualArtifactImage_MouseLeftButtonUp"/>

                                                    <TextBlock x:Name="VisualPreviewUnavailable"
                                                               Text="Image preview unavailable"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="#718DA6"
                                                               Visibility="Collapsed"/>
                                                </Grid>

                                                <StackPanel Margin="11,9,11,10">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#DFF4FF"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="VisualArtifactCaption"
                                                               Text="{Binding Caption}"
                                                               Margin="0,4,0,0"
                                                               FontSize="11"
                                                               LineHeight="16"
                                                               Foreground="#91A8BE"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                <Setter TargetName="VisualPreviewUnavailable" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasCaption}" Value="False">
                                                <Setter TargetName="VisualArtifactCaption" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The real empty assistant message keeps the V11 indicator alive
                                 only while waiting for first text / visual artifact. -->
                            <Border x:Name="JourneyIndicator"
                                    Grid.Row="0" Grid.RowSpan="3"
                                    Padding="12,10" MinWidth="300" MaxWidth="640"
                                    HorizontalAlignment="Left"
                                    Background="#14244A70"
                                    BorderBrush="#704BA2CA" BorderThickness="1"
                                    CornerRadius="12" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <typing:NIRATypingIndicator Width="42" Height="19"
                                        IndicatorStyle="FinalDepthDrift" SpeedMultiplier="0.85"
                                        IsHitTestVisible="False"/>
                                    <StackPanel Margin="11,0,0,0">
                                        <TextBlock Text="NIRA · WORKING" FontSize="10"
                                            FontWeight="SemiBold" Foreground="#65DDF5"/>
                                        <TextBlock Text="{Binding ProgressText}"
                                            FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                            Foreground="#E0F1FF" MaxWidth="560"
                                            Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasRichElements}" Value="True">
                    <Setter TargetName="AssistantRichBlocks" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasVisualArtifacts}" Value="True">
                    <Setter TargetName="AssistantVisualArtifacts" Property="Visibility" Value="Visible"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding HasContent}" Value="False">
                    <Setter TargetName="AssistantContentText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasContent}" Value="False"/>
                        <Condition Binding="{Binding HasVisualArtifacts}" Value="False"/>
                        <Condition Binding="{Binding HasRichElements}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="JourneyIndicator" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="AssistantBubble" Property="Padding" Value="6,1,8,0"/>
                    <Setter TargetName="AssistantBubble" Property="MinWidth" Value="300"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:ChatMessageTemplateSelector x:Key="ChatMessageTemplateSelector"
                                           UserTemplate="{StaticResource UserMessageTemplate}"
                                           AssistantTemplate="{StaticResource AssistantMessageTemplate}"/>
    

        <!-- =========================================================
             NIRA NEXT-LEVEL GLASS SYSTEM
             Real local background crop + blur is provided by
             NIRABackdropBorder; tint layers stay deliberately quiet.
             ========================================================= -->

        <Style x:Key="GlassPanelStyle" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <ui:NIRABackdropBorder Margin="-18"
                                                    BlurRadius="16"
                                                    BackdropOpacity="0.68"/>
                            <Border Background="{DynamicResource NIRAGlassTintBrush}"
                                    BorderBrush="{DynamicResource NIRAGlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPanelStrongStyle" TargetType="ContentControl" BasedOn="{StaticResource GlassPanelStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <ui:NIRABackdropBorder Margin="-20"
                                                    BlurRadius="18"
                                                    BackdropOpacity="0.72"/>
                            <Border Background="{DynamicResource NIRAGlassStrongTintBrush}"
                                    BorderBrush="{DynamicResource NIRAGlassBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="21"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource NIRAActivityCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ActionRoot" ClipToBounds="True">
                            <ui:NIRABackdropBorder x:Name="ActionBackdrop"
                                                  Margin="-14"
                                                  BlurRadius="14"
                                                  BackdropOpacity="0.82"/>
                            <Border x:Name="ActionGlass"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="18"
                                    SnapsToDevicePixels="True"/>
                            <Border x:Name="ActionHover"
                                    Background="{DynamicResource NIRACardHoverBrush}"
                                    CornerRadius="18"
                                    Opacity="0"/>
                            <ContentPresenter Margin="22,18,22,18"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionHover" Property="Opacity" Value="1"/>
                                <Setter TargetName="ActionGlass" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionRoot" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassQuickButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassActionButtonStyle}">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Background" Value="{DynamicResource NIRAPanelBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="QuickRoot" ClipToBounds="True">
                            <ui:NIRABackdropBorder Margin="-10" BlurRadius="10" BackdropOpacity="0.55"/>
                            <Border x:Name="QuickGlass"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    SnapsToDevicePixels="True"/>
                            <Border x:Name="QuickHover"
                                    Background="{DynamicResource NIRACardHoverBrush}"
                                    CornerRadius="14"
                                    Opacity="0"/>
                            <ContentPresenter Margin="13,8"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="QuickHover" Property="Opacity" Value="1"/>
                                <Setter TargetName="QuickGlass" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="QuickRoot" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource NIRAChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TopChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TopChrome" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                                <Setter TargetName="TopChrome" Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRASecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="NavHover"
                                    Background="{DynamicResource NIRACardHoverBrush}"
                                    CornerRadius="13"
                                    Margin="2,6"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                            <Border x:Name="NavLine"
                                    Height="2"
                                    Background="{DynamicResource NIRABlueBrush}"
                                    VerticalAlignment="Bottom"
                                    Margin="16,0"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavHover" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="ACTIVE">
                                <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
                                <Setter TargetName="NavLine" Property="Opacity" Value="1"/>
                                <Setter TargetName="NavHover" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeModeToggleStyle" TargetType="Button">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="{DynamicResource NIRAChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ThemeChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"/>
                            <Border x:Name="ThemeGlow"
                                    Margin="1"
                                    CornerRadius="13"
                                    BorderBrush="{DynamicResource NIRAFocusBorderBrush}"
                                    BorderThickness="1"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeGlow" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="ThemeChrome" Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ThemeChrome" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowGlyphButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRASecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowChrome"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WindowChrome" Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                                <Setter TargetName="WindowChrome" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComposerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{DynamicResource NIRACyanBrush}"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootShell" Background="{DynamicResource NIRABackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Theme-specific full-window backgrounds. -->
        <Image x:Name="BackgroundEclipse"
               Grid.RowSpan="2"
               Source="Assets/nira-background-eclipse.png"
               Stretch="UniformToFill"
               Opacity="1"
               IsHitTestVisible="False"/>
        <Image x:Name="BackgroundHalo"
               Grid.RowSpan="2"
               Source="Assets/nira-background-halo.png"
               Stretch="UniformToFill"
               Opacity="0"
               IsHitTestVisible="False"/>

        <!-- Quiet depth veil: readable UI without hiding the artwork. -->
        <Rectangle Grid.RowSpan="2" Opacity="0.45" Fill="{DynamicResource NIRABackdropVeilBrush}"
                   IsHitTestVisible="False"/>

        <Ellipse x:Name="AmbientGlowLeft"
                 Grid.RowSpan="2"
                 Width="430" Height="430"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-210,70,0,0"
                 Fill="{DynamicResource NIRASoftGlow}"
                 Opacity="0.5"
                 IsHitTestVisible="False"/>
        <Ellipse x:Name="AmbientGlowRight"
                 Grid.RowSpan="2"
                 Width="520" Height="520"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-250,-260"
                 Fill="{DynamicResource NIRAVioletGlow}"
                 Opacity="0.35"
                 IsHitTestVisible="False"/>

        <!-- =====================================================
             TOP CHROME
             ===================================================== -->
        <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <ui:NIRABackdropBorder Margin="0,-14,0,-6" BlurRadius="12" BackdropOpacity="0.45"/>
            <Border Background="{DynamicResource NIRATopBarTintBrush}"
                    BorderBrush="{DynamicResource NIRAGlassBorderBrush}"
                    BorderThickness="0,0,0,1"/>

            <Grid Margin="18,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Official NIRA mark; preserves the existing 44x44 top-bar footprint. -->
                    <Image Width="44"
                           Height="44"
                           Margin="0,0,13,0"
                           Source="Assets/Nira-Icon.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           IsHitTestVisible="False"/>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="NIRA"
                                       FontFamily="Bahnschrift"
                                       FontStretch="SemiCondensed"
                                       FontSize="29"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource NIRATextBrush}"/>
                            <Border Width="1" Height="16"
                                    Margin="10,1,9,0"
                                    Background="{DynamicResource NIRACyanBrush}"
                                    Opacity="0.58"/>
                            <TextBlock Text="BY ELVARA"
                                       Margin="0,3,0,0"
                                       FontFamily="Bahnschrift"
                                       FontStretch="Condensed"
                                       FontSize="8.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource NIRASecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="CALM INTELLIGENCE  ·  PRESENT WITH YOU"
                                   Margin="1,-1,0,0"
                                   FontFamily="Bahnschrift"
                                   FontStretch="Condensed"
                                   FontSize="7"
                                   Foreground="{DynamicResource NIRAMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,0">
                    <Button Style="{StaticResource NavButtonStyle}" Content="Chat" Tag="ACTIVE"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Memory"
                            Tag="Show me the most relevant things you remember about our current work."
                            Click="QuickPrompt_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Goals"
                            Tag="Show my active goals and what currently deserves attention."
                            Click="QuickPrompt_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="Tools"
                            Tag="What tools and capabilities can you use for me right now?"
                            Click="QuickPrompt_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}" Content="System"
                            Tag="Give me a concise status of your current system state and active work."
                            Click="QuickPrompt_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Style="{StaticResource TopActionButtonStyle}" Content="Settings" Click="SettingsButton_Click"/>
                    <Button x:Name="PermissionsButton" Style="{StaticResource TopActionButtonStyle}" Content="Permissions" Click="PermissionsButton_Click"/>
                    <Button x:Name="ThemeModeButton"
                            Style="{StaticResource ThemeModeToggleStyle}"
                            Click="ThemeModeButton_Click"
                            ToolTip="Switch appearance">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ThemeModeOrb"
                                    Width="26" Height="26"
                                    CornerRadius="13"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource NIRASoftGlow}"
                                    BorderBrush="{DynamicResource NIRAFocusBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock x:Name="ThemeModeIcon"
                                           Text="◐"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource NIRATextBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,4,0">
                                <TextBlock x:Name="ThemeModeText"
                                           Text="ECLIPSE"
                                           FontFamily="Bahnschrift"
                                           FontStretch="Condensed"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource NIRATextBrush}"/>
                                <TextBlock Text="THEME"
                                           Margin="0,-1,0,0"
                                           FontFamily="Bahnschrift"
                                           FontStretch="Condensed"
                                           FontSize="6.5"
                                           Foreground="{DynamicResource NIRAMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="⌄"
                                       Margin="1,-2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource NIRASecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Border Height="36" Margin="0,0,8,0" Padding="13,0"
                            Background="{DynamicResource NIRAChipBrush}"
                            BorderBrush="{DynamicResource NIRAGlassBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LivePulseDot" Width="6" Height="6" Fill="{DynamicResource NIRAGreenBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="LIVE" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource WindowGlyphButtonStyle}"
                            Content="&#xE7E8;"
                            Margin="4,0,4,0"
                            Foreground="#FF8A9C"
                            ToolTip="Exit NIRA completely"
                            AutomationProperties.Name="Exit NIRA completely"
                            Click="ExitAgentButton_Click"/>
                    <Button Style="{StaticResource WindowGlyphButtonStyle}"
                            Content="&#xE921;"
                            ToolTip="Minimize"
                            Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource WindowGlyphButtonStyle}"
                            Content="&#xE922;"
                            ToolTip="Maximize / Restore"
                            Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource WindowGlyphButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="Close interface"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- =====================================================
             MAIN WORKSPACE
             ===================================================== -->
        <Grid Grid.Row="1" Margin="12,10,12,12" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="276"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="268"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT / PRESENCE -->
            <ContentControl Grid.Column="0" Style="{StaticResource GlassPanelStrongStyle}">
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="210"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OnlinePulseDot" Width="6" Height="6" Fill="{DynamicResource NIRAGreenBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="PRESENCE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NIRACyanBrush}"/>
                            <TextBlock Text="  ONLINE" FontSize="9.5" Margin="8,1,0,0" Foreground="{DynamicResource NIRAGreenBrush}"/>
                        </StackPanel>
                        <TextBlock Text="NIRA is here" Margin="0,7,0,0" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Calm mind. Deeper insight. Further together."
                                   Margin="0,4,0,0" FontSize="11.5" LineHeight="16"
                                   Foreground="{DynamicResource NIRASecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1" x:Name="NIRADockHost" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!--
                            The live CompanionWindow particle body docks here.
                            Old concentric rings stay named for compatibility with
                            existing state-animation code, but are intentionally
                            collapsed so the new particle body has no geometric shell.
                        -->
                        <Ellipse Margin="44"
                                 Fill="{DynamicResource NIRASoftGlow}"
                                 Opacity="0.16"
                                 IsHitTestVisible="False"/>
                        <Ellipse x:Name="OrbRingOuter" Visibility="Collapsed"/>
                        <Ellipse x:Name="OrbRingMiddle" Visibility="Collapsed"/>
                        <Ellipse x:Name="OrbRingInner" Visibility="Collapsed"/>
                        <Ellipse x:Name="OrbRingCore" Visibility="Collapsed"/>
                    </Grid>

                    <Border x:Name="NIRAStatusPanel" Grid.Row="2"
                            Margin="0,0,0,10" Padding="11,9"
                            Background="{DynamicResource NIRAGlassTintBrush}"
                            BorderBrush="{DynamicResource NIRAGlassBorderBrush}"
                            BorderThickness="1" CornerRadius="13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="MindStateIndicator" Width="6" Height="6" Fill="{DynamicResource NIRABlueBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MIND" FontSize="9.5" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="MindStateText" Text="IDLE" Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NIRABlueBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource NIRAGlassBorderBrush}"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="BODY" FontSize="9.5" Foreground="{DynamicResource NIRASecondaryBrush}" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="BodyStateText" Text="RESTING" Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NIRABlueBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3">
                        <Border x:Name="VisionStatePanel" Padding="10,8" Margin="0,0,0,8"
                                Background="{DynamicResource NIRAGlassTintBrush}" BorderBrush="{DynamicResource NIRAGlassBorderBrush}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Ellipse x:Name="VisionActivityDot" Width="6" Height="6" Fill="#465F7E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VisionActivityText" Grid.Column="1" Text="EYES IDLE" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="AccessStatePanel" Padding="10,9" Margin="0,0,0,12"
                                Background="{DynamicResource NIRAGlassTintBrush}" BorderBrush="{DynamicResource NIRAGlassBorderBrush}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Ellipse x:Name="AccessPulseDot" Width="7" Height="7" Fill="{DynamicResource NIRACyanBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ACCESS" FontSize="9" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                    <TextBlock x:Name="PermissionStateText" Text="NO ACTIONS WAITING" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="4" Height="1" Background="{DynamicResource NIRAGlassBorderBrush}" Opacity="0.65"/>

                    <ScrollViewer Grid.Row="5" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel x:Name="BranchActivitySection">
                                <TextBlock x:Name="BranchActivityTitleText" Text="ACTIVE BRANCHES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NIRACyanBrush}"/>
                                <TextBlock x:Name="NoBranchActivityText" Text="No active branches" Margin="0,7,0,8" FontSize="10.5" Foreground="{DynamicResource NIRAMutedBrush}"/>
                                <StackPanel x:Name="BranchCardsPanel"/>
                            </StackPanel>

                            <Border x:Name="ActivitySectionDivider" Height="1" Margin="0,8,0,12" Background="{DynamicResource NIRAGlassBorderBrush}" Opacity="0.55"/>

                            <StackPanel x:Name="CommitmentActivitySection">
                                <TextBlock Text="ACTIVE COMMITMENTS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NIRAVioletBrush}"/>
                                <TextBlock x:Name="NoCommitmentActivityText" Text="No active commitments" Margin="0,7,0,8" FontSize="10.5" Foreground="{DynamicResource NIRAMutedBrush}"/>
                                <StackPanel x:Name="CommitmentCardsPanel"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ContentControl>
            <!-- CENTER / DIALOGUE -->
            <Grid Grid.Column="2" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="146"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,0,8,0">
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="10,6" CornerRadius="12"
                            Background="{DynamicResource NIRAChipBrush}"
                            BorderBrush="{DynamicResource NIRABorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectedPulseDot" Width="6" Height="6" Fill="{DynamicResource NIRABlueBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="READY" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Landing page; hidden automatically once messages exist. -->
                    <Grid x:Name="LandingPanel" Margin="0,18,0,0" Background="Transparent">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="230"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="INTELLIGENCE  ·  CLARITY  ·  PROGRESS"
                                       HorizontalAlignment="Center" FontSize="8" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NIRASecondaryBrush}"/>
                            <TextBlock x:Name="GreetingText" Text="Good evening."
                                       Margin="0,16,0,0" HorizontalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="50" FontWeight="Light"
                                       Foreground="{DynamicResource NIRATextBrush}"/>
                            <TextBlock Text="I’m NIRA. How can I help you today?"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"
                                       FontSize="21" FontWeight="Normal"
                                       Foreground="{DynamicResource NIRASecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                                <Border Width="54" Height="1" Background="{DynamicResource NIRAGlassBorderBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <TextBlock Text="THINK DEEPER     WORK SMARTER     A BRIGHTER YOU"
                                           FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource NIRABlueBrush}"/>
                                <Border Width="54" Height="1" Background="{DynamicResource NIRAGlassBorderBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="18,0,18,0">
                            <Button Style="{StaticResource GlassActionButtonStyle}" Margin="0,0,10,0"
                                    Background="{DynamicResource NIRAActivityCardBrush}"
                                    BorderBrush="#6898D9FF"
                                    Tag="Help me explore an idea. Ask me what I’m thinking about, then brainstorm and challenge it with me."
                                    Click="QuickPrompt_Click">
                                <StackPanel>
                                    <Border Width="54" Height="54" CornerRadius="27" Background="#1C78B7FF" BorderBrush="#4698D9FF" BorderThickness="1">
                                        <TextBlock Text="✦" FontSize="24" Foreground="{DynamicResource NIRABlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Explore Ideas" Margin="0,18,0,0" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Brainstorm, expand perspectives, and discover new possibilities."
                                               Margin="0,10,0,0" FontSize="10.5" LineHeight="16" Foreground="{DynamicResource NIRASecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassActionButtonStyle}" Margin="3,0,7,0"
                                    Background="{DynamicResource NIRAActivityCardBrush}"
                                    BorderBrush="#9B7CFFFF"
                                    Tag="Help me work on a project. Ask what project I want to move forward, then help me plan and execute the next useful step."
                                    Click="QuickPrompt_Click">
                                <StackPanel>
                                    <Border Width="54" Height="54" CornerRadius="27" Background="#1E8B5CFF" BorderBrush="#559B7CFF" BorderThickness="1">
                                        <TextBlock Text="□" FontSize="22" Foreground="{DynamicResource NIRAVioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Work on a Project" Margin="0,18,0,0" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Plan, organize, and make progress on what matters."
                                               Margin="0,10,0,0" FontSize="10.5" LineHeight="16" Foreground="{DynamicResource NIRASecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassActionButtonStyle}" Margin="7,0,3,0"
                                    Background="{DynamicResource NIRAActivityCardBrush}"
                                    BorderBrush="#5EDBFFFF"
                                    Tag="Help me define a goal. Turn what I want into a clear objective, useful next steps, and completion criteria."
                                    Click="QuickPrompt_Click">
                                <StackPanel>
                                    <Border Width="54" Height="54" CornerRadius="27" Background="#1A44B9CB" BorderBrush="#505EDBFF" BorderThickness="1">
                                        <TextBlock Text="◎" FontSize="22" Foreground="{DynamicResource NIRACyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Set a Goal" Margin="0,18,0,0" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Turn your aspirations into clear steps and real outcomes."
                                               Margin="0,10,0,0" FontSize="10.5" LineHeight="16" Foreground="{DynamicResource NIRASecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassActionButtonStyle}" Margin="10,0,0,0"
                                    Background="{DynamicResource NIRAActivityCardBrush}"
                                    BorderBrush="#7B8DFFFF"
                                    Tag="Show me how you can use your tools and PC capabilities for what I’m doing right now."
                                    Click="QuickPrompt_Click">
                                <StackPanel>
                                    <Border Width="54" Height="54" CornerRadius="27" Background="#1C566DFF" BorderBrush="#487B8DFF" BorderThickness="1">
                                        <TextBlock Text="▦" FontSize="22" Foreground="{DynamicResource NIRAVioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Use Tools" Margin="0,18,0,0" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Access powerful tools to create, analyze, research, and more."
                                               Margin="0,10,0,0" FontSize="10.5" LineHeight="16" Foreground="{DynamicResource NIRASecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>

                    <!-- Real conversation surface. -->
                    <ScrollViewer x:Name="ChatScroll"
                                  Background="Transparent"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="6,28,4,0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Messages}"
                                      ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"/>
                    </ScrollViewer>
                </Grid>

                <ContentControl x:Name="ComposerPanel" Grid.Row="2" Style="{StaticResource GlassPanelStrongStyle}">
                    <Grid Margin="14,12,14,10">
                        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" ClipToBounds="True">
                            <ui:NIRABackdropBorder Margin="-10" BlurRadius="10" BackdropOpacity="0.75"/>
                            <Border Background="{DynamicResource NIRAInputTintBrush}"
                                    BorderBrush="{DynamicResource NIRABorderStrongBrush}"
                                    BorderThickness="1" CornerRadius="17"/>
                            <Grid Margin="14,7,8,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,10,0"
                                        Style="{StaticResource WindowGlyphButtonStyle}" Content="⌂"/>
                                <TextBox x:Name="MessageInput" Grid.Column="1"
                                         Style="{StaticResource ComposerTextBoxStyle}"
                                         Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="MessageInput_PreviewKeyDown"
                                         VerticalAlignment="Stretch"/>
                                <TextBlock Grid.Column="1" Text="Message NIRA..."
                                           Margin="5,0,0,0" VerticalAlignment="Center"
                                           FontSize="14" Foreground="{DynamicResource NIRAMutedBrush}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MessageInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MessageInput}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="2" Width="44" Height="44" Margin="10,0,8,0"
                                        Style="{StaticResource TopActionButtonStyle}" Content="◉"/>
                                <Button Grid.Column="3" Width="52" Height="52"
                                        Background="{DynamicResource NIRAPrimaryButtonFill}"
                                        BorderBrush="#66B8FFFF"
                                        BorderThickness="1"
                                        Foreground="White"
                                        Command="{Binding SendCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                                                <TextBlock Text="➤" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="1" Margin="2,10,2,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource TopActionButtonStyle}" Height="32" Padding="12,0" Content="Deep Think"
                                        Tag="Think deeply about this. Start by asking me what problem I want to reason through."
                                        Click="QuickPrompt_Click"/>
                                <Button Style="{StaticResource TopActionButtonStyle}" Height="32" Padding="12,0" Content="Search"
                                        Tag="Help me search and research something. Ask what I want to investigate."
                                        Click="QuickPrompt_Click"/>
                                <Button Style="{StaticResource TopActionButtonStyle}" Height="32" Padding="12,0" Content="Browse"
                                        Tag="Help me browse or inspect something on the PC or web. Ask what I need."
                                        Click="QuickPrompt_Click"/>
                                <Button Style="{StaticResource TopActionButtonStyle}" Height="32" Padding="12,0" Content="Create Image"
                                        Tag="Help me create an image. Ask what I want it to look like."
                                        Click="QuickPrompt_Click"/>
                                <Button Style="{StaticResource TopActionButtonStyle}" Height="32" Padding="12,0" Content="Analyze File"
                                        Tag="Help me analyze a file. Ask me to provide the file or explain what I need checked."
                                        Click="QuickPrompt_Click"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Press Enter to send  •  Shift + Enter for new line"
                                       VerticalAlignment="Center" FontSize="9.5" Foreground="{DynamicResource NIRAMutedBrush}"/>
                        </Grid>
                    </Grid>
                </ContentControl>
            </Grid>
            <!-- RIGHT / QUICK TOOLS -->
            <StackPanel Grid.Column="4">
                <ContentControl Style="{StaticResource GlassPanelStrongStyle}">
                    <StackPanel Margin="14,14,14,7">
                        <Grid Margin="1,0,1,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="QUICK TOOLS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NIRABlueBrush}"/>
                            <TextBlock Grid.Column="1" Text="•••" FontSize="12" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                        </Grid>

                        <Button Style="{StaticResource GlassQuickButtonStyle}" Tag="Summarize what I provide next. Preserve the important details and keep the result concise." Click="QuickPrompt_Click">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#140F4C9A" BorderBrush="#446AA8FF" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="≡" FontSize="21" Foreground="{DynamicResource NIRABlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Summarize" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="Condense and clarify content" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}"/></StackPanel>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource GlassQuickButtonStyle}" Tag="Analyze what I provide next. Find the important patterns, problems, tradeoffs, and actionable insights." Click="QuickPrompt_Click">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#140B8CC6" BorderBrush="#4474CCFF" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="▥" FontSize="18" Foreground="{DynamicResource NIRACyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Analyze" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="Find insights and patterns" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}"/></StackPanel>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource GlassQuickButtonStyle}" Tag="Help me create something. Ask what I want to make and then help me produce it." Click="QuickPrompt_Click">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#14136CFF" BorderBrush="#6289FFFF" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="✦" FontSize="18" Foreground="{DynamicResource NIRAVioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Create" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="Generate content and ideas" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}"/></StackPanel>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource GlassQuickButtonStyle}" Tag="Help me make a practical plan. Ask what outcome I want, then break it into useful steps and dependencies." Click="QuickPrompt_Click">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#142655C8" BorderBrush="#617DFFFF" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="☷" FontSize="18" Foreground="{DynamicResource NIRABlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Plan" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="Break down and organize" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}"/></StackPanel>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource GlassQuickButtonStyle}" Tag="Help me research a topic. Ask what I want to know and what kind of sources or depth I need." Click="QuickPrompt_Click" Margin="0,0,0,2">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#140B7A88" BorderBrush="#589AD4F8" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="⌕" FontSize="20" Foreground="{DynamicResource NIRACyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Research" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="Explore and compare sources" FontSize="10" Foreground="{DynamicResource NIRASecondaryBrush}"/></StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ContentControl>

                <!-- Past chat cards come from the real SQLite archive; no mock entries. -->
                <ContentControl Style="{StaticResource GlassPanelStyle}" Margin="0,12,0,0">
                    <StackPanel Margin="14,14,14,12">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="PAST CHATS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NIRABlueBrush}"/>
                            <Button Grid.Column="1" Content="↻" ToolTip="Refresh past chats" Padding="5,0" Click="RefreshPastChats_Click"
                                    FontSize="14" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                        </Grid>
                        <TextBox x:Name="PastChatFilterBox" TextChanged="PastChatFilter_TextChanged"
                                 ToolTip="Filter saved chats by their opening message"
                                 Height="30" Margin="0,0,0,5" Padding="9,5" FontSize="10.5"
                                 Background="{DynamicResource NIRAGlassTintBrush}"
                                 Foreground="White"
                                 BorderBrush="{DynamicResource NIRAGlassBorderBrush}" BorderThickness="1"/>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="FILTER BY OPENING MESSAGE" FontSize="9.5" Foreground="{DynamicResource NIRAMutedBrush}"/>
                            <TextBlock x:Name="PastChatsCountText" HorizontalAlignment="Right" FontSize="9.5"
                                       Foreground="{DynamicResource NIRASecondaryBrush}"/>
                        </Grid>
                        <TextBlock x:Name="NoPastChatsText" Text="No past chats yet. They appear after NIRA restarts."
                                   TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource NIRAMutedBrush}"/>
                        <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PastChatsListPanel"/>
                        </ScrollViewer>
                        <Border x:Name="PastChatAttachStrip" Visibility="Collapsed" Margin="0,10,0,0"
                                Background="{DynamicResource NIRAGlassTintBrush}" BorderBrush="{DynamicResource NIRAGlassBorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="8">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Detach source" Click="DetachPastChat_Click"
                                        BorderThickness="0" Background="Transparent" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="ATTACHED TO NEXT MESSAGE" FontSize="9.5" Foreground="{DynamicResource NIRACyanBrush}"/>
                                    <TextBlock Text="{Binding AttachedPastChatName}" FontSize="10.5" MaxWidth="182"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>
    </Grid>
</Window>


