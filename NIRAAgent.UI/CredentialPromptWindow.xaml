<Window x:Class="NIRAAgent.UI.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NIRA Secure Login"
        Width="560"
        Height="520"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NIRABackgroundBrush}"
        Foreground="{DynamicResource NIRATextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        ResizeMode="NoResize">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SECURE CREDENTIAL BRIDGE"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource NIRACyanBrush}"/>
            <TextBlock Text="NIRA needs a login"
                       Margin="0,7,0,0"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="OriginText"
                       Margin="0,7,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource NIRASecondaryBrush}"/>
            <TextBlock x:Name="ReasonText"
                       Margin="0,9,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource NIRASecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{DynamicResource NIRAGlassBorderBrush}"
                Background="{DynamicResource NIRAGlassTintBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Saved account"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource NIRAMutedBrush}"/>
                    <ComboBox x:Name="ExistingCredentialCombo"
                              Margin="0,6,0,8"
                              DisplayMemberPath="DisplayName"/>
                    <Button x:Name="UseStoredButton"
                            Content="Use selected saved login"
                            Height="34"
                            HorizontalAlignment="Left"
                            Padding="14,0"
                            Click="UseStored_Click"/>

                    <Separator Margin="0,18,0,16"/>

                    <TextBlock Text="New / replacement login"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource NIRAMutedBrush}"/>

                    <TextBlock Text="Account label" Margin="0,10,0,4"/>
                    <TextBox x:Name="AccountLabelBox"/>

                    <TextBlock Text="Username / email" Margin="0,10,0,4"/>
                    <TextBox x:Name="UsernameBox"/>

                    <TextBlock Text="Password / secret" Margin="0,10,0,4"/>
                    <PasswordBox x:Name="SecretBox"/>

                    <TextBlock Margin="0,13,0,0"
                               TextWrapping="Wrap"
                               FontSize="10"
                               Foreground="{DynamicResource NIRASecondaryBrush}"
                               Text="The secret goes directly to NIRA's trusted credential runtime. It is not inserted into the LLM prompt, browser capability arguments, memory, or normal action logs."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Use once"
                    MinWidth="100"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="UseOnce_Click"/>
            <Button Grid.Column="1"
                    Content="Save &amp; use"
                    MinWidth="112"
                    Height="36"
                    Click="SaveAndUse_Click"/>
            <Button Grid.Column="3"
                    Content="Cancel"
                    MinWidth="88"
                    Height="36"
                    Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>

