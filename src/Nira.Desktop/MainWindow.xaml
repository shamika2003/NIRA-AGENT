                                    <Path x:Name="ChevronExpanded" Width="7" Height="12" Data="M 6,1 L 1,6 L 6,11" Stretch="Fill" Stroke="#BFD8F8" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.86"/>

                                    <Path x:Name="ChevronCollapsed" Width="7" Height="12" Data="M 1,1 L 6,6 L 1,11" Stretch="Fill" Stroke="#DDF7FF" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Opacity="0.96"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Collapsed">
                                <Setter TargetName="ChevronExpanded" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ChevronCollapsed" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="HandleChrome" Property="Background" Value="#6808172A"/>
