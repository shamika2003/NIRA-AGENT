<Window x:Class="Nira.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NIRA | ELVARA" Width="1100" Height="740" MinWidth="740" MinHeight="540"
        Background="#080F20" Foreground="#ECF4FF">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#15345D"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#326CBA"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="5"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="◉  NIRA" Foreground="#70C8FF" FontSize="28" FontWeight="SemiBold"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="New conversation" Click="NewConversation_Click"/>
        <Button Content="Resume previous" Click="Resume_Click"/>
        <Button Content="Workspace" Click="Workspace_Click"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" BorderBrush="#29456A" BorderThickness="1" CornerRadius="10"
            Background="#0D1A31" Padding="16">
      <ScrollViewer x:Name="ChatScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ConversationPanel"/>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0" x:Name="PromptBox" Height="66" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" Background="#122844" Foreground="White"
               FontSize="15" Padding="12" BorderBrush="#326CBA"/>
      <Button Grid.Column="1" x:Name="SendButton" Content="Send" Width="100" Click="Send_Click"/>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="StatusLabel" Margin="4,9,0,0" Foreground="#86ACC7"
               Text="Ready — permissions remain enforced by the kernel"/>
  </Grid>
</Window>
