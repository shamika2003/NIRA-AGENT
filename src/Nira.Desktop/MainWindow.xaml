<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:ui="clr-namespace:NIRAAgent.UI" xmlns:gallery="clr-namespace:NIRAAgent.UI.Presentation" x:Class="Nira.Desktop.MainWindow" Title="NIRA by ELVARA" Width="1440" Height="900" MinWidth="1000" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource NIRABackgroundBrush}" Foreground="{DynamicResource NIRATextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"><WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One motion vocabulary: soft, non-elastic easing. -->
        <CubicEase x:Key="NIRAMotionEase" EasingMode="EaseOut"/>
        <SineEase x:Key="NIRAMotionPressEase" EasingMode="EaseInOut"/>
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#08060915" Offset="0"/>
            <GradientStop Color="#12091230" Offset="1"/>
        </LinearGradientBrush>

        <!-- Thin, low-distraction scrollbars for chat, activity lists and inputs. -->
        <Style x:Key="ThinScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#7B5A8AC6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot" Margin="0" Background="{TemplateBinding Background}" CornerRadius="2" Opacity="0.52"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="ThumbRoot" Property="Background" Value="#A070A9E6"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Opacity" Value="1"/>
                                <Setter TargetName="ThumbRoot" Property="Background" Value="#C178DBFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.76"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollRoot" Background="Transparent">
                            <Track x:Name="PART_Track" Focusable="False" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="5"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="5"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Native-inspired window controls: flat, quiet, and familiar,
             while keeping NIRA's dark blue interface language. -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#91A8BE"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#25213144"/>
                                <Setter Property="Foreground" Value="#E8F5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#34314A63"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8C3B3045"/>
                    <Setter Property="Foreground" Value="#FFF3F6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B64A3148"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="124"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#15111F3E"/>
            <Setter Property="Foreground" Value="#D9F5FF"/>
            <Setter Property="BorderBrush" Value="#4C5E7CFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Glow" CornerRadius="9" Background="#1A558CFF" Opacity="0.24"/>
                            <Border x:Name="Core" Margin="1" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.82"/>
                                <Setter TargetName="Core" Property="Background" Value="#2920496A"/>
                                <Setter TargetName="Core" Property="BorderBrush" Value="#AA82FFFF"/>
                                <Setter Property="Foreground" Value="#F6FDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button" BasedOn="{StaticResource NIRAPrimaryButtonStyle}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Glow" Width="38" Height="38" Fill="#1E4578FF" Opacity="0.46"/>
                            <Border x:Name="Core" Margin="2" CornerRadius="11" Background="{DynamicResource NIRAPrimaryButtonFill}" BorderBrush="#B6C8FAFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                <ContentPresenter x:Name="SendGlyphHost" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SendGlyphHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.065" Duration="0:0:0.24" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="SendGlyphHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.065" Duration="0:0:0.24" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SendGlyphHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="SendGlyphHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.26" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                <Setter TargetName="Core" Property="BorderBrush" Value="#F0E8FFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                                                    <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Core" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955" EasingFunction="{StaticResource NIRAMotionPressEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.022" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Core" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955" EasingFunction="{StaticResource NIRAMotionPressEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.022" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================================================
             NIRA NEXT-LEVEL GLASS SYSTEM
             Real local background crop + blur is provided by
             NIRABackdropBorder; tint layers stay deliberately quiet.
             ========================================================= -->

        <Style x:Key="GlassPanelStyle" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <ui:NIRABackdropBorder Margin="-18" BlurRadius="16" BackdropOpacity="0.68"/>
                            <Border Background="{DynamicResource NIRAGlassTintBrush}" BorderBrush="{DynamicResource NIRAGlassBorderBrush}" BorderThickness="1" CornerRadius="20" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPanelStrongStyle" TargetType="ContentControl" BasedOn="{StaticResource GlassPanelStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <ui:NIRABackdropBorder Margin="-20" BlurRadius="18" BackdropOpacity="0.72"/>
                            <Border Background="{DynamicResource NIRAGlassStrongTintBrush}" BorderBrush="{DynamicResource NIRAGlassBorderStrongBrush}" BorderThickness="1" CornerRadius="21" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource NIRAActivityCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ActionRoot" ClipToBounds="True">
                            <ui:NIRABackdropBorder x:Name="ActionBackdrop" Margin="-14" BlurRadius="14" BackdropOpacity="0.82"/>
                            <Border x:Name="ActionGlass" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" SnapsToDevicePixels="True"/>
                            <Border x:Name="ActionHover" Background="{DynamicResource NIRACardHoverBrush}" CornerRadius="18" Opacity="0"/>
                            <ContentPresenter Margin="22,18,22,18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionHover" Property="Opacity" Value="1"/>
                                <Setter TargetName="ActionGlass" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionRoot" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassQuickButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassActionButtonStyle}">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Background" Value="{DynamicResource NIRAPanelBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="QuickRoot" ClipToBounds="True">
                            <ui:NIRABackdropBorder Margin="-10" BlurRadius="10" BackdropOpacity="0.55"/>
                            <Border x:Name="QuickGlass" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            </Border>
                            <Border x:Name="QuickHover" Background="{DynamicResource NIRACardHoverBrush}" CornerRadius="14" Opacity="0"/>
                            <ContentPresenter Margin="12,7"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="QuickHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="QuickHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.27" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                
                                <Setter TargetName="QuickGlass" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                            </Trigger>
                                                    <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="QuickGlass" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955" EasingFunction="{StaticResource NIRAMotionPressEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.022" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="QuickGlass" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955" EasingFunction="{StaticResource NIRAMotionPressEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.022" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource NIRAChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="10.8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TopChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TopChrome" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                                <Setter TargetName="TopChrome" Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                            </Trigger>
                                                    <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TopChrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955" EasingFunction="{StaticResource NIRAMotionPressEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.022" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TopChrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955" EasingFunction="{StaticResource NIRAMotionPressEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.022" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRASecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="NavHover" Background="{DynamicResource NIRACardHoverBrush}" CornerRadius="13" Margin="2,6" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                            <Border x:Name="NavLine" Height="2" Background="{DynamicResource NIRABlueBrush}" VerticalAlignment="Bottom" Margin="16,0" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="NavHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="NavHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.27" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                
                                <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="ACTIVE">
                                <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
                                <Setter TargetName="NavLine" Property="Opacity" Value="1"/>
                                <Setter TargetName="NavHover" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeModeToggleStyle" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource NIRAChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ThemeChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            </Border>
                            <Border x:Name="ThemeGlow" Margin="1" CornerRadius="13" BorderBrush="{DynamicResource NIRAFocusBorderBrush}" BorderThickness="1" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeGlow" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="ThemeChrome" Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ThemeChrome" Property="Opacity" Value="0.8"/>
                            </Trigger>
                                                    <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThemeChrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955" EasingFunction="{StaticResource NIRAMotionPressEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.022" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ThemeChrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955" EasingFunction="{StaticResource NIRAMotionPressEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.022" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================
             CHAT FOCUS / EDGE HANDLES

             These are intentionally not ordinary buttons. They behave like
             small pieces of NIRA's glass shell: thin, quiet edge handles that
             only brighten when the pointer approaches them.
             ===================================================== -->
        <Style x:Key="SidebarEdgeHandleBaseStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="Background" Value="#52071120"/>
            <Setter Property="BorderBrush" Value="#3B6E9CC7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRASecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Panel.ZIndex" Value="30"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" SnapsToDevicePixels="True">
                            <ui:NIRABackdropBorder Margin="-8" BlurRadius="12" BackdropOpacity="0.72"/>

                            <!-- soft outer bloom -->
                            <Border x:Name="HandleBloom" Margin="-2" CornerRadius="12" BorderBrush="#3672D9FF" BorderThickness="1" Opacity="0.10"/>

                            <!-- main glass capsule -->
                            <Border x:Name="HandleChrome" Margin="2,5" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                <Grid>
                                    <!-- quiet cyan energy line -->
                                    <Border x:Name="EnergyLine" Width="1" Height="30" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#75A9EEFF" Opacity="0.34"/>

                                    <!-- tiny center node gives it a NIRA-instrument feel -->
                                    <Ellipse x:Name="CenterNode" Width="3.5" Height="3.5" Fill="{DynamicResource NIRACyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.72"/>

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HandleBloom" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.24" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HandleBloom" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.27" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                
                                <Setter TargetName="HandleChrome" Property="Background" Value="#9A0A1B30"/>
                                <Setter TargetName="HandleChrome" Property="BorderBrush" Value="{DynamicResource NIRAFocusBorderBrush}"/>
                                <Setter TargetName="EnergyLine" Property="Opacity" Value="0.74"/>
                                <Setter TargetName="CenterNode" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HandleBloom" Property="Opacity" Value="0.35"/>
                            </Trigger>
                                                    <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace"><Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HandleChrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955" EasingFunction="{StaticResource NIRAMotionPressEase}"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.02" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HandleChrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.955" EasingFunction="{StaticResource NIRAMotionPressEase}"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.02" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1" EasingFunction="{StaticResource NIRAMotionEase}"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard></BeginStoryboard>
                            </EventTrigger>
</ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left edge: expanded points outward, collapsed points inward. -->
