<UserControl x:Class="NIRAAgent.UI.Presentation.NIRAMemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource NIRATextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <UserControl.Resources>
        <Style x:Key="MemoryNavStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource NIRAChipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="ACTIVE">
                    <Setter Property="Background" Value="{DynamicResource NIRACardHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource NIRABlueBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MemoryActionStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource NIRAChipBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NIRATextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NIRAGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="19" Background="{DynamicResource NIRAGlassStrongTintBrush}"
                BorderBrush="{DynamicResource NIRAGlassBorderBrush}" BorderThickness="1" Padding="17,22">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="PERSONAL INTELLIGENCE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NIRACyanBrush}"/>
                    <TextBlock Text="NIRA’s Memory" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="25" Margin="0,8,0,3" FontWeight="SemiBold"/>
                    <TextBlock Text="What NIRA remembers and learns." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource NIRASecondaryBrush}" Margin="0,0,0,24"/>
                    <Button x:Name="NotesButton" Content="Saved memories" Click="Notes_Click" Tag="ACTIVE" Style="{StaticResource MemoryNavStyle}"/>
                    <Button x:Name="SuggestionsButton" Content="Learning suggestions" Click="Suggestions_Click" Style="{StaticResource MemoryNavStyle}"/>
                    <Button x:Name="SkillsButton" Content="Learned skills" Click="Skills_Click" Style="{StaticResource MemoryNavStyle}"/>
                    <Button x:Name="PreferencesButton" Content="Memory preferences" Click="Preferences_Click" Style="{StaticResource MemoryNavStyle}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border Height="1" Margin="0,12,0,13" Background="{DynamicResource NIRAGlassBorderBrush}"/>
                    <TextBlock Text="PRIVATE LOCAL MEMORY" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                    <TextBlock Text="Saved notes are separate from conversations. You control recall and learning." TextWrapping="Wrap" FontSize="10.5" Margin="0,7,0,0" Foreground="{DynamicResource NIRASecondaryBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" CornerRadius="19" BorderThickness="1" BorderBrush="{DynamicResource NIRAGlassBorderBrush}" Background="{DynamicResource NIRAGlassTintBrush}" Padding="20,17">
            <Grid x:Name="PageCard">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="↻  Refresh" Click="Refresh_Click" Style="{StaticResource MemoryActionStyle}" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock x:Name="SectionTitle" Text="Saved memories" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SectionSummary" Text="Review and manage the notes NIRA can recall." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource NIRASecondaryBrush}" Margin="0,5,12,0"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PageBody" Margin="0,0,10,0"/>
                </ScrollViewer>
                <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready" TextWrapping="Wrap" Foreground="{DynamicResource NIRASecondaryBrush}" FontSize="12" Margin="0,12,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
