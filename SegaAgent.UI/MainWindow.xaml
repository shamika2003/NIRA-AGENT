<Window x:Class="SegaAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SegaAgent.UI.ViewModels"
        Title="SegaAI"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource SegaBackgroundBrush}"
        Foreground="{StaticResource SegaTextBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C0060915" Offset="0"/>
            <GradientStop Color="#D0091230" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="UserBubble" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BB223D84" Offset="0"/>
            <GradientStop Color="#C4205CB2" Offset="1"/>
        </LinearGradientBrush>


        <!-- Thin, low-distraction scrollbars for chat, activity lists and inputs. -->
        <Style x:Key="ThinScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#7B5A8AC6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                Margin="0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Opacity="0.52"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="ThumbRoot" Property="Background" Value="#A070A9E6"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Opacity" Value="1"/>
                                <Setter TargetName="ThumbRoot" Property="Background" Value="#C178DBFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.76"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollRoot"
                              Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="5"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="5"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Native-inspired window controls: flat, quiet, and familiar,
             while keeping Sega's dark blue interface language. -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#91A8BE"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#25213144"/>
                                <Setter Property="Foreground" Value="#E8F5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#34314A63"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8C3B3045"/>
                    <Setter Property="Foreground" Value="#FFF3F6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B64A3148"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="124"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#15111F3E"/>
            <Setter Property="Foreground" Value="#D9F5FF"/>
            <Setter Property="BorderBrush" Value="#4C5E7CFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Glow"
                                    CornerRadius="9"
                                    Background="#1A558CFF"
                                    Opacity="0.24"/>
                            <Border x:Name="Core"
                                    Margin="1"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.82"/>
                                <Setter TargetName="Core" Property="Background" Value="#2920496A"/>
                                <Setter TargetName="Core" Property="BorderBrush" Value="#AA82FFFF"/>
                                <Setter Property="Foreground" Value="#F6FDFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Core" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button" BasedOn="{StaticResource SegaPrimaryButtonStyle}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Glow"
                                     Width="46"
                                     Height="46"
                                     Fill="#1E4578FF"
                                     Opacity="0.46"/>
                            <Border x:Name="Core"
                                    Margin="3"
                                    CornerRadius="14"
                                    Background="{StaticResource SegaPrimaryButtonFill}"
                                    BorderBrush="#B6C8FAFF"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                <Setter TargetName="Core" Property="BorderBrush" Value="#F0E8FFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Core" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="UserMessageTemplate">
            <StackPanel x:Name="UserMessageRoot"
                        HorizontalAlignment="Right"
                        Margin="96,0,0,20"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="UserMessageTranslate" X="4"/>
                </StackPanel.RenderTransform>
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="UserMessageRoot"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="UserMessageTranslate"
                                                 Storyboard.TargetProperty="X"
                                                 From="4" To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
                <TextBlock Text="YOU"
                           HorizontalAlignment="Right"
                           Margin="0,0,8,6"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#6686A6"/>
                <Grid MaxWidth="720">
                    <Border Margin="-2"
                            CornerRadius="18,18,5,18"
                            Background="#18396CFF"
                            Opacity="0.48"/>
                    <Border Margin="1"
                            Padding="17,12"
                            Background="{StaticResource UserBubble}"
                            BorderBrush="#7570F4FF"
                            BorderThickness="1"
                            CornerRadius="17,17,5,17">
                        <TextBlock Text="{Binding Content}"
                                   Foreground="{StaticResource SegaTextBrush}"
                                   FontSize="14"
                                   LineHeight="21"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate">
            <StackPanel x:Name="AssistantMessageRoot"
                        HorizontalAlignment="Left"
                        Margin="0,0,96,22"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="AssistantMessageTranslate" X="-4"/>
                </StackPanel.RenderTransform>
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="AssistantMessageRoot"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="AssistantMessageTranslate"
                                                 Storyboard.TargetProperty="X"
                                                 From="-4" To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,6">
                    <Ellipse Width="6" Height="6"
                             Fill="{StaticResource SegaCyanBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,7,0"/>
                    <TextBlock Text="SEGA"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SegaCyanBrush}"/>
                </StackPanel>

                <Grid MaxWidth="740">
                    <Border x:Name="AssistantBubbleGlow"
                            Margin="-2"
                            CornerRadius="18,18,18,5"
                            Background="#142F9DFF"
                            Opacity="0.42"/>

                    <Border x:Name="AssistantBubble"
                            Margin="1"
                            Padding="17,12"
                            MinWidth="0"
                            Background="#D20A1726"
                            BorderBrush="#4B3C8DB8"
                            BorderThickness="1"
                            CornerRadius="17,17,17,5">
                        <Grid>
                            <TextBlock x:Name="AssistantContentText"
                                       Text="{Binding Content}"
                                       Foreground="{StaticResource SegaTextBrush}"
                                       FontSize="14"
                                       LineHeight="21"
                                       TextWrapping="Wrap"/>

                            <!-- Empty assistant messages are the real streaming/thinking
                                 placeholder. Show a restrained living indicator instead
                                 of rendering a blank tiny chat bubble. -->
                            <Grid x:Name="ThinkingIndicator"
                                  Width="46"
                                  Height="18"
                                  HorizontalAlignment="Left"
                                  Visibility="Collapsed">
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="ThinkingDot1"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.28" To="1"
                                                                 Duration="0:0:0.52"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="ThinkingDot2"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.28" To="1"
                                                                 BeginTime="0:0:0.16"
                                                                 Duration="0:0:0.52"
                                                                 AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="ThinkingDot3"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.28" To="1"
                                                                 BeginTime="0:0:0.32"
                                                                 Duration="0:0:0.52"
                                                                 AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Ellipse x:Name="ThinkingDot1"
                                             Width="5"
                                             Height="5"
                                             Margin="0,0,7,0"
                                             Fill="{StaticResource SegaCyanBrush}"
                                             Opacity="0.28"/>
                                    <Ellipse x:Name="ThinkingDot2"
                                             Width="5"
                                             Height="5"
                                             Margin="0,0,7,0"
                                             Fill="{StaticResource SegaBlueBrush}"
                                             Opacity="0.28"/>
                                    <Ellipse x:Name="ThinkingDot3"
                                             Width="5"
                                             Height="5"
                                             Fill="{StaticResource SegaVioletBrush}"
                                             Opacity="0.28"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Content}" Value="">
                    <Setter TargetName="AssistantContentText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ThinkingIndicator" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="AssistantBubble" Property="Padding" Value="11,9"/>
                    <Setter TargetName="AssistantBubble" Property="MinWidth" Value="70"/>
                    <Setter TargetName="AssistantBubbleGlow" Property="Opacity" Value="0.28"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:ChatMessageTemplateSelector x:Key="ChatMessageTemplateSelector"
                                           UserTemplate="{StaticResource UserMessageTemplate}"
                                           AssistantTemplate="{StaticResource AssistantMessageTemplate}"/>
    </Window.Resources>

    <Grid x:Name="RootShell" Background="{StaticResource SegaWindowGradient}">
        <Ellipse x:Name="AmbientGlowLeft" Width="720" Height="720"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-390,-430,0,0"
                 Fill="{StaticResource SegaSoftGlow}"
                 Opacity="0.58"
                 IsHitTestVisible="False"/>
        <Ellipse x:Name="AmbientGlowRight" Width="600" Height="600"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-300,-360"
                 Fill="{StaticResource SegaVioletGlow}"
                 Opacity="0.44"
                 IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0"
                    Background="#B006101C"
                    BorderBrush="#29356891"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                          Width="34"
                          Height="34"
                          Margin="0,0,11,0"
                          VerticalAlignment="Center">
                        <Ellipse Width="34" Height="34" Fill="#0E2F75D8"/>
                        <Ellipse Width="22" Height="22" Fill="#1B4EDFFF"/>
                        <Ellipse Width="9" Height="9" Fill="{StaticResource SegaCyanBrush}"/>
                        <Ellipse Width="3" Height="3" Fill="White"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SEGA"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SegaTextBrush}"/>
                            <TextBlock Text="  /  COGNITIVE INTERFACE"
                                       FontSize="9"
                                       VerticalAlignment="Center"
                                       Foreground="#557795"/>
                        </StackPanel>
                        <TextBlock Text="Persistent embodied desktop intelligence"
                                   FontSize="9"
                                   Margin="0,2,0,0"
                                   Foreground="#486783"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="SettingsButton"
                                Width="96"
                                Content="Settings"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="SettingsButton_Click"/>

                        <Button x:Name="PermissionsButton"
                                Content="Permissions"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="PermissionsButton_Click"/>

                        <Border Width="72"
                                Height="30"
                                Margin="0,0,8,0"
                                CornerRadius="9"
                                Background="#1A182B26"
                                BorderBrush="#3A5F87D8"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="LivePulseDot" Width="6"
                                         Height="6"
                                         Fill="{StaticResource SegaGreenBrush}"
                                         Margin="0,0,6,0"/>
                                <TextBlock Text="LIVE"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#B7E8FF"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource WindowControlButton}"
                                Click="MinimizeButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="12" Height="1"
                                  Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  Data="M0,0 L12,0"/>
                        </Button>
                        <Button Style="{StaticResource WindowControlButton}"
                                Click="MaximizeButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="11" Height="11"
                                  Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M0.8,0.8 L10.2,0.8 L10.2,10.2 L0.8,10.2 Z"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="11" Height="11"
                                  Stretch="Fill"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Data="M1,1 L10,10 M10,1 L1,10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN WORKSPACE -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="348"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SEGA / BODY COLUMN -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarGradient}"
                        BorderBrush="#2A2D6D93"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="22,20,22,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="286"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="2,0,0,4">
                            <TextBlock Text="PRESENCE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SegaCyanBrush}"/>
                            <TextBlock Text="Sega is here"
                                       Margin="0,4,0,0"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SegaTextBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Width="276"
                              Height="276"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Ellipse x:Name="OrbRingOuter" Width="276"
                                     Height="276"
                                     Fill="{StaticResource SegaSoftGlow}"
                                     Opacity="0.96"
                                     IsHitTestVisible="False"/>
                            <Ellipse x:Name="OrbRingMiddle" Width="242"
                                     Height="242"
                                     Stroke="#3B57C9FF"
                                     StrokeThickness="1"
                                     Opacity="0.68"
                                     IsHitTestVisible="False"/>
                            <Ellipse x:Name="OrbRingInner" Width="194"
                                     Height="194"
                                     Stroke="#303EA5FF"
                                     StrokeThickness="1"
                                     Opacity="0.54"
                                     IsHitTestVisible="False"/>
                            <Ellipse x:Name="OrbRingCore" Width="136"
                                     Height="136"
                                     Stroke="#2C67E8FF"
                                     StrokeThickness="1"
                                     Opacity="0.44"
                                     IsHitTestVisible="False"/>
                            <Border x:Name="SegaDockHost"
                                    Width="260"
                                    Height="260"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"/>
                        </Grid>

                        <Border x:Name="SegaStatusPanel" Grid.Row="2"
                                Style="{StaticResource SegaGlassPanelStrong}"
                                Padding="15,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="MindStateIndicator"
                                                 Width="6" Height="6"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{StaticResource SegaCyanBrush}"/>
                                        <TextBlock Text="MIND"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#5F7F9C"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MindStateText"
                                               Text="IDLE"
                                               Margin="0,4,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SegaCyanBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Margin="0,1"
                                        Background="{StaticResource SegaNeonLine}"
                                        Opacity="0.38"/>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="BODY"
                                               HorizontalAlignment="Right"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#5F7F9C"/>
                                    <TextBlock x:Name="BodyStateText"
                                               Text="RESTING"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#8EBBFF"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="AccessStatePanel" Grid.Row="4"
                                Style="{StaticResource SegaGlassPanel}"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="30" Height="30" VerticalAlignment="Center">
                                    <Ellipse Width="30" Height="30" Fill="#171B6CA5"/>
                                    <Ellipse x:Name="AccessPulseDot" Width="8" Height="8" Fill="{StaticResource SegaCyanBrush}"/>
                                </Grid>
                                <StackPanel Grid.Column="1"
                                            Margin="11,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="ACCESS"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#6385A3"/>
                                    <TextBlock x:Name="PermissionStateText"
                                               Text="NO ACTIONS WAITING"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#A7DDF4"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- LIVE PERSISTENT ACTIVITY PROJECTION -->
                        <ScrollViewer Grid.Row="5"
                                      Margin="0,14,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <StackPanel Margin="0,0,4,2">
                                <StackPanel x:Name="BranchActivitySection">
                                    <StackPanel Orientation="Horizontal"
                                                Margin="2,0,0,8">
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="{StaticResource SegaCyanBrush}"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="ACTIVE BRANCHES"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#6E93B5"/>
                                    </StackPanel>

                                    <TextBlock x:Name="NoBranchActivityText"
                                               Text="No active branches"
                                               Margin="3,1,3,8"
                                               FontSize="10"
                                               Foreground="#536C8B"/>

                                    <StackPanel x:Name="BranchCardsPanel"/>
                                </StackPanel>

                                <Border x:Name="ActivitySectionDivider"
                                        Height="1"
                                        Margin="2,10,2,12"
                                        Background="{StaticResource SegaNeonLine}"
                                        Opacity="0.30"/>

                                <StackPanel x:Name="CommitmentActivitySection">
                                    <StackPanel Orientation="Horizontal"
                                                Margin="2,0,0,8">
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="{StaticResource SegaVioletBrush}"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="ACTIVE COMMITMENTS"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#8875B9"/>
                                    </StackPanel>

                                    <TextBlock x:Name="NoCommitmentActivityText"
                                               Text="No active commitments"
                                               Margin="3,1,3,8"
                                               FontSize="10"
                                               Foreground="#536C8B"/>

                                    <StackPanel x:Name="CommitmentCardsPanel"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="6"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,2">
                            <Ellipse x:Name="OnlinePulseDot" Width="5"
                                     Height="5"
                                     Fill="{StaticResource SegaCyanBrush}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="SEGA / ONLINE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="#557A99"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CHAT COLUMN -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="94"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#56070B18"
                            BorderBrush="#2539548A"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="26,0,22,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DIALOGUE"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SegaCyanBrush}"/>
                                <TextBlock Text="Conversation with Sega"
                                           Margin="0,3,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SegaTextBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectedPulseDot" Width="5"
                                         Height="5"
                                         Fill="{StaticResource SegaBlueBrush}"
                                         Margin="0,0,7,0"/>
                                <TextBlock Text="CONNECTED"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#6688A7"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ChatScroll"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <ItemsControl ItemsSource="{Binding Messages}"
                                      Margin="30,28,24,30">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplateSelector="{StaticResource ChatMessageTemplateSelector}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Background="#EE040811"
                            BorderBrush="#2B466CBB"
                            BorderThickness="0,1,0,0">
                        <Grid Margin="22,12,22,13">
                            <Border CornerRadius="18"
                                    Background="#153D73FF"
                                    Opacity="0.55"
                                    Margin="-2"/>
                            <Border x:Name="ComposerPanel"
                                    Style="{StaticResource SegaGlassPanelStrong}"
                                    CornerRadius="16"
                                    Padding="8,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0"
                                          Width="34"
                                          Height="34"
                                          Margin="3,0,10,0"
                                          VerticalAlignment="Center">
                                        <Ellipse Width="34" Height="34" Fill="#221E55B8"/>
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource SegaCyanBrush}"/>
                                        <Ellipse Width="3" Height="3" Fill="White"/>
                                    </Grid>

                                    <TextBox x:Name="MessageInput"
                                             Grid.Column="1"
                                             Margin="0,0,10,0"
                                             Padding="4,8"
                                             MinHeight="42"
                                             MaxHeight="120"
                                             Background="Transparent"
                                             Foreground="{StaticResource SegaTextBrush}"
                                             CaretBrush="{StaticResource SegaCyanBrush}"
                                             BorderThickness="0"
                                             FontSize="15"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="MessageInput_PreviewKeyDown"/>

                                    <Button x:Name="SendButton"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SendButtonStyle}"
                                            Command="{Binding SendCommand}">
                                        <Path Width="17"
                                              Height="17"
                                              Stretch="Uniform"
                                              Fill="#03111D"
                                              Data="M2,2 L18,10 L2,18 L5.2,11.7 L12.3,10 L5.2,8.3 Z"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.RowSpan="2"
                    Height="1"
                    VerticalAlignment="Top"
                    Background="{StaticResource SegaNeonLine}"
                    Opacity="0.58"
                    IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>