<Window x:Class="SegaAgent.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sega Settings"
        Width="760"
        Height="760"
        MinWidth="660"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource SegaBackgroundBrush}"
        Foreground="{StaticResource SegaTextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingsWindowControl" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9FB4C9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#21324B63"/>
                                <Setter Property="Foreground" Value="#EEF7FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCloseButton" TargetType="Button" BasedOn="{StaticResource SettingsWindowControl}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B53A1521"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8F4FF"/>
        </Style>

        <Style x:Key="SettingsDescription" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#718BA4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SegaWindowGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#B0060A16"
                BorderBrush="#2840618C"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SETTINGS"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource SegaTextBrush}"/>
                    <TextBlock Text="Sega behavior, presence and interface preferences"
                               Margin="0,2,0,0"
                               FontSize="9"
                               Foreground="#53738F"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SettingsWindowControl}"
                            Click="Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="12" Height="1" Stretch="Fill"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" Data="M0,0 L12,0"/>
                    </Button>
                    <Button Style="{StaticResource SettingsCloseButton}"
                            Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="11" Height="11" Stretch="Fill"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Data="M1,1 L10,10 M10,1 L1,10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,22,24,28">

                <!-- VOICE -->
                <TextBlock Text="Voice" Style="{StaticResource SettingsSectionTitle}"/>
                <TextBlock Text="Control when and how Sega speaks. Chat text is unaffected."
                           Style="{StaticResource SettingsDescription}"/>

                <Border Style="{StaticResource SegaGlassPanelStrong}" Padding="18,13" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox x:Name="VoiceEnabledCheck"
                                  Content="Speak chat replies"
                                  Checked="VoiceEnabled_Changed"
                                  Unchecked="VoiceEnabled_Changed"/>
                        <TextBlock Text="Turn Sega's spoken responses on or off. Turning this off immediately stops current speech."
                                   Margin="28,-1,0,8"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>

                        <CheckBox x:Name="BackgroundVoiceCheck"
                                  Content="Speak background updates"
                                  Checked="BackgroundVoice_Changed"
                                  Unchecked="BackgroundVoice_Changed"/>
                        <TextBlock Text="Allow autonomous/background work updates to use voice."
                                   Margin="28,-1,0,10"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="54"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Voice volume" FontWeight="SemiBold" Foreground="#D9E8F5"/>
                                <TextBlock Text="Applies to new speech playback."
                                           Style="{StaticResource SettingsDescription}"/>
                            </StackPanel>
                            <Slider x:Name="VoiceVolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="VoiceVolume_Changed"/>
                            <TextBlock x:Name="VoiceVolumeText"
                                       Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#A7DDF4"/>
                        </Grid>

                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Voice engine" FontWeight="SemiBold" Foreground="#D9E8F5"/>
                                <TextBlock Text="Auto prefers Groq when available and falls back to Piper."
                                           Style="{StaticResource SettingsDescription}"/>
                            </StackPanel>
                            <ComboBox x:Name="VoiceEngineBox"
                                      Grid.Column="1"
                                      Height="34"
                                      VerticalAlignment="Center"
                                      SelectionChanged="VoiceEngine_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PRESENCE / IDLE -->
                <TextBlock Text="Presence &amp; idle" Style="{StaticResource SettingsSectionTitle}" Margin="0,22,0,0"/>
                <TextBlock Text="Control Sega's desktop presence and what user inactivity means to her."
                           Style="{StaticResource SettingsDescription}"/>

                <Border Style="{StaticResource SegaGlassPanelStrong}" Padding="18,13" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox x:Name="DesktopPresenceCheck"
                                  Content="Show Sega on the desktop when chat is not active"
                                  Checked="DesktopPresence_Changed"
                                  Unchecked="DesktopPresence_Changed"/>
                        <TextBlock Text="If disabled, Sega still appears inside the main chat interface, but her free desktop body stays hidden."
                                   Margin="28,-1,0,9"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>

                        <CheckBox x:Name="IdleBehaviorCheck"
                                  Content="Enable idle behavior"
                                  Checked="IdleBehavior_Changed"
                                  Unchecked="IdleBehavior_Changed"/>
                        <TextBlock Text="Controls idle-triggered awareness and quiet-presence behavior. Sega's internal MIND can still be IDLE when she has nothing to do."
                                   Margin="28,-1,0,9"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>

                        <CheckBox x:Name="IdleAwarenessCheck"
                                  Content="Notice when I have been inactive"
                                  Checked="IdleAwareness_Changed"
                                  Unchecked="IdleAwareness_Changed"/>
                        <TextBlock Text="Allows the UserIdle event to enter Sega's attention system."
                                   Margin="28,-1,0,9"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>

                        <CheckBox x:Name="IdleFadeCheck"
                                  Content="Fade Sega's desktop presence when idle"
                                  Checked="IdleFade_Changed"
                                  Unchecked="IdleFade_Changed"/>
                        <TextBlock Text="When Sega is resting and inactive, her desktop body becomes quieter instead of remaining fully bright."
                                   Margin="28,-1,0,9"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="28,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Fade after"
                                       FontWeight="SemiBold"
                                       Foreground="#C6D8E8"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="IdleFadeDelayBox"
                                      Grid.Column="1"
                                      Height="32"
                                      SelectionChanged="IdleFadeDelay_Changed">
                                <ComboBoxItem Content="30 seconds" Tag="30"/>
                                <ComboBoxItem Content="1 minute" Tag="60"/>
                                <ComboBoxItem Content="3 minutes" Tag="180"/>
                                <ComboBoxItem Content="5 minutes" Tag="300"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ATTENTION / AUTONOMY -->
                <TextBlock Text="Attention &amp; autonomy" Style="{StaticResource SettingsSectionTitle}" Margin="0,22,0,0"/>
                <TextBlock Text="These settings affect ambient attention only. Active goals, branches and requested work keep running."
                           Style="{StaticResource SettingsDescription}"/>

                <Border Style="{StaticResource SegaGlassPanelStrong}" Padding="18,13" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox x:Name="ProactiveCompanionCheck"
                                  Content="Allow proactive companion checks"
                                  Checked="ProactiveCompanion_Changed"
                                  Unchecked="ProactiveCompanion_Changed"/>
                        <TextBlock Text="After a quiet period Sega may reconsider whether there is a natural reason to interact. A check does not force her to speak."
                                   Margin="28,-1,0,9"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>

                        <CheckBox x:Name="PcContextReactionsCheck"
                                  Content="React to foreground app and window changes"
                                  Checked="PcContextReactions_Changed"
                                  Unchecked="PcContextReactions_Changed"/>
                        <TextBlock Text="The PC world model still tracks the current screen context when disabled, but app/window changes do not become attention events."
                                   Margin="28,-1,0,2"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- NOTIFICATIONS -->
                <TextBlock Text="Notifications" Style="{StaticResource SettingsSectionTitle}" Margin="0,22,0,0"/>
                <TextBlock Text="Choose how Sega surfaces requests that need your attention."
                           Style="{StaticResource SettingsDescription}"/>

                <Border Style="{StaticResource SegaGlassPanelStrong}" Padding="18,13" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox x:Name="PermissionNotificationsCheck"
                                  Content="Show non-intrusive permission alerts"
                                  Checked="PermissionNotifications_Changed"
                                  Unchecked="PermissionNotifications_Changed"/>
                        <TextBlock Text="If disabled, pending requests still appear in the Permissions count and Access panel, but no desktop toast is shown."
                                   Margin="28,-1,0,2"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- INTERFACE -->
                <TextBlock Text="Interface" Style="{StaticResource SettingsSectionTitle}" Margin="0,22,0,0"/>
                <TextBlock Text="Choose what persistent state is visible without changing Sega's actual goals or commitments."
                           Style="{StaticResource SettingsDescription}"/>

                <Border Style="{StaticResource SegaGlassPanelStrong}" Padding="18,13" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox x:Name="CardParticlesCheck"
                                  Content="Particle transitions for branches and commitments"
                                  Checked="CardParticles_Changed"
                                  Unchecked="CardParticles_Changed"/>
                        <TextBlock Text="Controls only the small materialize/dissolve particle effect on work cards."
                                   Margin="28,-1,0,9"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>

                        <CheckBox x:Name="ShowBranchesCheck"
                                  Content="Show active branches in the sidebar"
                                  Checked="ShowBranches_Changed"
                                  Unchecked="ShowBranches_Changed"/>

                        <CheckBox x:Name="ShowCommitmentsCheck"
                                  Content="Show active commitments in the sidebar"
                                  Checked="ShowCommitments_Changed"
                                  Unchecked="ShowCommitments_Changed"/>
                        <TextBlock Text="Hiding a section changes only the interface. It never cancels or pauses the underlying state."
                                   Margin="28,-1,0,2"
                                   FontSize="10.5"
                                   Foreground="#718BA4"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Button Content="Reset to defaults"
                        Width="138"
                        HorizontalAlignment="Left"
                        Margin="0,22,0,0"
                        Style="{StaticResource SegaButtonBaseStyle}"
                        Click="Reset_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#B0060A16"
                BorderBrush="#26316A90"
                BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource SegaCyanBrush}" Margin="0,0,7,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Changes are saved automatically"
                               FontSize="10"
                               Foreground="#73BDE1"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
