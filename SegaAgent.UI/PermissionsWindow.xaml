<Window x:Class="SegaAgent.UI.PermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sega Permissions"
        Width="1080"
        Height="760"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource SegaBackgroundBrush}"
        Foreground="{StaticResource SegaTextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PermissionWindowButton" TargetType="Button" BasedOn="{StaticResource SegaButtonBaseStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="PermissionWindowControl" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#91A8BE"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#25213144"/>
                                <Setter Property="Foreground" Value="#E8F5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#34314A63"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionCloseButton" TargetType="Button" BasedOn="{StaticResource PermissionWindowControl}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8C3B3045"/>
                    <Setter Property="Foreground" Value="#FFF3F6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B64A3148"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SegaWindowGradient}">
        <Ellipse Width="620" Height="620"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-320,-380,0,0"
                 Fill="{StaticResource SegaSoftGlow}"
                 Opacity="0.65"
                 IsHitTestVisible="False"/>
        <Ellipse Width="520" Height="520"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-270,-300"
                 Fill="{StaticResource SegaVioletGlow}"
                 Opacity="0.48"
                 IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0"
                    Background="#B0060A16"
                    BorderBrush="#2840618C"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="PermissionsTitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,11,0" VerticalAlignment="Center">
                        <Ellipse Width="34" Height="34" Fill="#0E2F75D8"/>
                        <Ellipse Width="22" Height="22" Fill="#1B4EDFFF"/>
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource SegaCyanBrush}"
                              Data="M5,0 L7,0 L7.8,2.2 L10,3 L10,5 L7.8,5.8 L7,8 L5,8 L4.2,5.8 L2,5 L2,3 L4.2,2.2 Z M6,2.8 A1.2,1.2 0 1 0 6,5.2 A1.2,1.2 0 1 0 6,2.8"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PERMISSIONS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SegaTextBrush}"/>
                        <TextBlock Text="Access control and action history" Margin="0,2,0,0" FontSize="9" Foreground="#53738F"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PermissionWindowControl}"
                                Click="PermissionsMinimize_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="12" Height="1" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Data="M0,0 L12,0"/>
                        </Button>
                        <Button Style="{StaticResource PermissionWindowControl}"
                                Click="PermissionsMaximize_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="11" Height="11" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M0.8,0.8 L10.2,0.8 L10.2,10.2 L0.8,10.2 Z"/>
                        </Button>
                        <Button Style="{StaticResource PermissionCloseButton}"
                                Click="PermissionsClose_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="11" Height="11" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M1,1 L10,10 M10,1 L1,10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="22,20,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Control what Sega can do"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SegaTextBrush}"/>
                        <TextBlock Text="Review pending actions, saved grants, and the runtime audit trail."
                                   Margin="0,5,0,0"
                                   Foreground="#7897B3"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="132" Height="34" CornerRadius="10"
                            Background="#1A13362C" BorderBrush="#3E42C7AA" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SegaGreenBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="RUNTIME LIVE" FontSize="9" FontWeight="SemiBold" Foreground="#A7F2DE"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TabControl x:Name="Tabs" Grid.Row="1">
                    <!-- REQUESTS -->
                    <TabItem Header="Requests">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Margin="2,2,0,11">
                                    <TextBlock Text="PENDING" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SegaCyanBrush}"/>
                                    <TextBlock Text="Requests waiting for you" Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ListBox x:Name="RequestsList"
                                         Grid.Row="1"
                                         SelectionChanged="Request_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <Border Grid.Column="2" Style="{StaticResource SegaGlassPanelStrong}" Padding="20,18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="2,0,10,0">
                                            <TextBlock x:Name="RequestTitle" Text="No pending request"
                                                       FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="RequestTarget" Margin="0,7,0,10" TextWrapping="Wrap"
                                                       Foreground="{StaticResource SegaCyanBrush}"/>
                                            <TextBlock x:Name="RequestNotice" TextWrapping="Wrap" Foreground="#A8BED3" Margin="0,0,0,16"/>

                                            <TextBlock Text="SEGA'S REASON" FontSize="9" FontWeight="SemiBold" Foreground="#6584A1"/>
                                            <TextBlock x:Name="RequestReason" TextWrapping="Wrap" Margin="0,5,0,16" Foreground="#D9E8F5"/>

                                            <TextBlock Text="EXACT REQUEST" FontSize="9" FontWeight="SemiBold" Foreground="#6584A1"/>
                                            <TextBox x:Name="RequestPreview"
                                                     IsReadOnly="True"
                                                     Height="175"
                                                     Margin="0,6,0,15"
                                                     FontFamily="Consolas"
                                                     FontSize="12"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"/>

                                            <TextBlock x:Name="RememberDescription" TextWrapping="Wrap" Foreground="#A8BED3"/>
                                            <TextBox x:Name="RememberRoot" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Grid Grid.Row="1" Margin="0,17,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="OnceButton"
                                                Grid.Column="0"
                                                Content="Allow once"
                                                Style="{StaticResource SegaPrimaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                Click="AllowOnce_Click"
                                                IsEnabled="False"/>
                                        <Button x:Name="RememberButton"
                                                Grid.Column="1"
                                                Content="Remember"
                                                Style="{StaticResource PermissionWindowButton}"
                                                Click="Remember_Click"
                                                IsEnabled="False"/>
                                        <Button x:Name="DenyButton"
                                                Grid.Column="2"
                                                Content="Deny"
                                                Style="{StaticResource SegaDangerButtonStyle}"
                                                Click="Deny_Click"
                                                IsEnabled="False"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="Pending approvals expire automatically."
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="#58748F"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- SAVED GRANTS -->
                    <TabItem Header="Saved grants">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SegaGlassPanelStrong}" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Grant project-folder access" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Folder path" Margin="0,11,0,0" FontSize="9" FontWeight="SemiBold" Foreground="#6685A1"/>
                                        <TextBox x:Name="ProjectRoot" Margin="0,5,14,8"/>
                                        <WrapPanel>
                                            <CheckBox x:Name="DownloadsCheck" Content="Allow downloads into this folder" Margin="0,3,20,3"/>
                                            <CheckBox x:Name="DestructiveCheck" Content="Allow destructive operations" Margin="0,3,20,3"/>
                                        </WrapPanel>
                                        <TextBlock Text="Command execution remains separately authorized."
                                                   Margin="0,7,0,0" FontSize="10" Foreground="#617D99"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Grant access"
                                            Width="124"
                                            Style="{StaticResource SegaPrimaryButtonStyle}"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,2"
                                            Click="GrantFolder_Click"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2" x:Name="ScopesList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="#A8BED3" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Revoke selected"
                                        Style="{StaticResource SegaDangerButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="Revoke_Click"/>
                                <Button Content="Refresh"
                                        Style="{StaticResource PermissionWindowButton}"
                                        Click="Refresh_Click"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- AUDIT -->
                    <TabItem Header="Action audit">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Latest authorization and execution records"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <DataGrid Grid.Row="2"
                                      x:Name="AuditGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="UTC time" Binding="{Binding TimeUtc}" Width="190"/>
                                    <DataGridTextColumn Header="Capability" Binding="{Binding Capability}" Width="160"/>
                                    <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="160"/>
                                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="280"/>
                                    <DataGridTextColumn Header="Evidence" Binding="{Binding Detail}" Width="360"/>
                                    <DataGridTextColumn Header="Scope" Binding="{Binding ScopeId}" Width="280"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Grid.Row="3"
                                    Content="Refresh audit"
                                    Width="118"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource PermissionWindowButton}"
                                    Click="Refresh_Click"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- STATUS -->
            <Border Grid.Row="2"
                    Background="#B0060A16"
                    BorderBrush="#26316A90"
                    BorderThickness="0,1,0,0">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource SegaCyanBrush}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusText"
                                   Text="0 pending requests Â· 0 active saved grants"
                                   FontSize="10"
                                   Foreground="#73BDE1"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.RowSpan="3" Height="1" VerticalAlignment="Top"
                    Background="{StaticResource SegaNeonLine}" Opacity="0.58" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>